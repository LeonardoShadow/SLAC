    private void IniciarTemporizadorCiclo()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = Task.Run(async () =>
        {
            while (!_cts.Token.IsCancellationRequested && _timer != null && await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_sesionCerrada)
                    {
                        return;
                    }

                    // Decrementar rotación (15s)
                    _segundosRestantesRotacion--;
                    if (_segundosRestantesRotacion <= 0)
                    {
                        _rotacion++;
                        _segundosRestantesRotacion = 15;
                        await RotarCodigoQrAsync();
                    }

                    // Decrementar tiempo total de apertura (20 min)
                    _segundosRestantesSesion--;
                    if (_segundosRestantesSesion <= 0)
                    {
                        await FinalizarSesionAsync();
                    }

                    StateHasChanged();
                });
            }
        }, _cts.Token);
    }

    private async Task RotarCodigoQrAsync()
    {
        if (_sesion == null) return;

        try
        {
            var segundosDesdeInicio = Math.Max(0, (int)(DateTimeOffset.UtcNow - _horaInicioSesion).TotalSeconds);
            _rotacion = segundosDesdeInicio / 15;

            var tokenString = TokenService.GenerateSessionQrToken(
                _sesion.Id,
                _sesion.InstitucionId,
                _horaInicioSesion,
                ventanaMinutos: _minutosCaducidad,
                rotacionIndex: _rotacion);

            var baseUrl = !string.IsNullOrWhiteSpace(_servidorBasePersonalizado)
                ? _servidorBasePersonalizado.TrimEnd('/')
                : (Navigation.BaseUri.Contains("localhost") || Navigation.BaseUri.Contains("127.0.0.1")
                    ? _ipLocalSugerida
                    : Navigation.BaseUri.TrimEnd('/'));

            var modoParam = _modoValidacion == "wifi" ? "&modo=wifi" : "";
            _urlEscaneoActual = $"{baseUrl}/a/{_sesion.Id}?t={tokenString}{modoParam}";
            _qrSvgContent = QrService.GenerateSvg(_urlEscaneoActual, pixelsPerModule: 10, darkColorHex: "#0F172A", lightColorHex: "#FFFFFF");

            // Actualizar caché de Redis para consistencia
            var estado = new SessionEphemeralState
            {
                SesionId = _sesion.Id,
                InstitucionId = _sesion.InstitucionId,
                MateriaId = _sesion.MateriaId,
                DocenteId = _sesion.DocenteId != Guid.Empty ? _sesion.DocenteId : (_materia?.DocenteId ?? Guid.Empty),
                InicioVigencia = _horaInicioSesion,
                Vencimiento = _horaInicioSesion.AddMinutes(_minutosCaducidad),
                RotacionIndex = _rotacion,
                TokenActual = tokenString,
                ContadorAsistentes = _totalPresentes,
                EstaAbierta = true
            };
            await SessionCache.SetActiveSessionAsync(estado, TimeSpan.FromMinutes(_minutosCaducidad));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al rotar código QR: {ex.Message}", Severity.Warning);
        }
    }

    private async Task CopiarEnlacePruebaAsync()
    {
        if (string.IsNullOrWhiteSpace(_urlEscaneoActual)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _urlEscaneoActual);
            Snackbar.Add("¡Enlace de alumno copiado al portapapeles! Pégalo en otra pestaña o ventana de incógnito para probar.", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"Enlace: {_urlEscaneoActual}", Severity.Info);
        }
    }

    private async Task CambiarHostBaseAsync(string nuevoHost)
    {
        _servidorBasePersonalizado = nuevoHost;
        await RotarCodigoQrAsync();
        var hostNombre = string.IsNullOrWhiteSpace(nuevoHost) ? "Localhost (PC)" : nuevoHost;
        Snackbar.Add($"Destino QR configurado a: {hostNombre}", Severity.Info);
        StateHasChanged();
    }

    private async Task FinalizarSesionAsync()
    {
        if (_sesion == null) return;

        _sesionCerrada = true;
        await ListaRepo.ActualizarEstadoAsync(_sesion.Id, "Cerrada", DateTime.Now.TimeOfDay);
        await SessionCache.InvalidateSessionAsync(_sesion.Id);

        try
        {
            var instId = _materia?.InstitucionId ?? _sesion.InstitucionId;
            var estudiantesSuscritos = await SuscripcionRepo.ListarEstudiantesIdsPorMateriaAsync(MateriaId);
            var registrosAsistencia = await DetalleRepo.ListarPorListaAsync(_sesion.Id);
            var presentesIds = new HashSet<Guid>(registrosAsistencia.Where(r => r.Estado == "Presente").Select(r => r.EstudianteId));
            var ausentesIds = estudiantesSuscritos.Where(id => !presentesIds.Contains(id)).ToList();

            var faltasRegistradas = await DetalleRepo.RegistrarFaltasIdempotenteAsync(
                _sesion.Id,
                instId,
                ausentesIds);

            var totalPresentes = presentesIds.Count;
            var totalFaltas = registrosAsistencia.Count(r => r.Estado == "Falta") + faltasRegistradas;
            await ListaRepo.ActualizarTotalesAsync(_sesion.Id, estudiantesSuscritos.Count, totalPresentes, totalFaltas);
            Snackbar.Add($"Sesión cerrada: {totalPresentes} presentes, {totalFaltas} faltas computadas.", Severity.Info);
        }
        catch
        {
            Snackbar.Add($"La ventana de asistencia ha cerrado.", Severity.Info);
        }
    }

    private async Task CerrarAsistenciaManualmente()
    {
        await FinalizarSesionAsync();
        StateHasChanged();
    }

    private async Task AbrirDialogoRevinculaciones()
    {
        var parameters = new DialogParameters<RevinculacionDialog>
        {
            { x => x.MateriaId, MateriaId },
            { x => x.DocenteNombre, _materia?.NombreDocente ?? "Docente Titular" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RevinculacionDialog>("Revinculación de Dispositivos", parameters, options);
        await dialog.Result;

        var pendientes = await RevinculacionService.ListarPendientesPorMateriaAsync(MateriaId);
        _solicitudesRevinculacionPendientes = pendientes.Count;
        StateHasChanged();
    }

    private async Task AbrirDialogoSuspensionEmergencia()
    {
        if (_sesion == null) return;

        var parameters = new DialogParameters<SuspensionClaseDialog>
        {
            { x => x.ListaId, _sesion.Id },
            { x => x.DocenteNombre, _materia?.NombreDocente ?? "Docente Titular" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SuspensionClaseDialog>("Suspender Clase de Emergencia", parameters, options);
        var res = await dialog.Result;
        if (res != null && !res.Canceled)
        {
            _sesionSuspendida = true;
            _sesionCerrada = true;
            StateHasChanged();
        }
    }

