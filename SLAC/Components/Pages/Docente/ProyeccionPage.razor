    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();

        if (_hubConnection != null)
        {
            if (_sesion != null)
            {
                try
                {
                    await _hubConnection.InvokeAsync("LeaveClassroomSession", _sesion.Id.ToString());
                }
                catch { }
            }
            await _hubConnection.DisposeAsync();
        }
    }
