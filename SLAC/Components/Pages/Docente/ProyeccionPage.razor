        await RotarCodigoQrAsync();
        Snackbar.Add($"Ajustes guardados: Modo {_modoValidacion.ToUpperInvariant()}, Duración: {_minutosCaducidad} min, Alcance: {_radioToleranciaMetros}m.", Severity.Success);
