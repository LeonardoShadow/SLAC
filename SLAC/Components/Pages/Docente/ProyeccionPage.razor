    private async Task CargarMateriaYSesionAsync()
    {
        _loading = true;
        try
        {
            _materia = await MateriaRepo.ObtenerPorIdAsync(MateriaId);
            if (_materia != null && _materia.EspacioId != Guid.Empty)
            {
                _espacio = await EspacioRepo.GetByIdAsync(_materia.EspacioId);
            }

            if (_espacio != null)
            {
                _latitudPersonalizada ??= _espacio.Latitud;
                _longitudPersonalizada ??= _espacio.Longitud;
            }
            _latitudPersonalizada ??= -17.776200;
            _longitudPersonalizada ??= -63.195100;
            _coordenadasPuntoATexto = $"{_latitudPersonalizada.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}, {_longitudPersonalizada.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";

            var hoy = TimeHelper.Today;
            var sesionExistente = await ListaRepo.ObtenerPorMateriaYFechaAsync(MateriaId, hoy);

            var docenteId = _materia?.DocenteId != null && _materia.DocenteId != Guid.Empty
                ? _materia.DocenteId
                : Guid.Parse("55555555-5555-5555-5555-555555555555");
            var espacioId = _materia?.EspacioId != null && _materia.EspacioId != Guid.Empty
                ? _materia.EspacioId
                : (_espacio?.Id != null && _espacio.Id != Guid.Empty ? _espacio.Id : Guid.Parse("d5cb8783-fe9a-4090-8bd3-c5d96d608fe9"));

            if (sesionExistente == null)
            {
                // Crear sesión para hoy si no existía (apertura inmediata)
                var nueva = new ListaAsistencia
                {
                    InstitucionId = _materia?.InstitucionId ?? Guid.Parse("11111111-1111-1111-1111-111111111111"),
                    MateriaId = MateriaId,
                    DocenteId = docenteId,
                    EspacioId = espacioId,
                    Fecha = hoy,
                    HoraInicio = _materia?.HoraInicio ?? TimeHelper.TimeOfDay,
                    Estado = "Abierta"
                };
                _sesion = await ListaRepo.CrearOActualizarAsync(nueva);
                _horaInicioSesion = DateTimeOffset.UtcNow;
                _segundosRestantesSesion = 20 * 60;
                _sesionCerrada = false;
            }
            else
            {
                _sesion = sesionExistente;
                if (_sesion.DocenteId == Guid.Empty)
                {
                    _sesion.DocenteId = docenteId;
                }
                if (_sesion.EspacioId == Guid.Empty)
                {
                    _sesion.EspacioId = espacioId;
                }

                if (ReabrirQuery == true)
                {
                    // Si el docente ingresó solicitando proyectar/reabrir
                    await ListaRepo.ActualizarEstadoAsync(_sesion.Id, "Abierta");
                    _sesion.Estado = "Abierta";
                    _horaInicioSesion = DateTimeOffset.UtcNow;
                    _segundosRestantesSesion = 20 * 60;
                    _sesionCerrada = false;
                    _sesionSuspendida = false;
                }
                else if (_sesion.Estado == "Programada")
                {
                    await ListaRepo.ActualizarEstadoAsync(_sesion.Id, "Abierta");
                    _sesion.Estado = "Abierta";
                    _horaInicioSesion = DateTimeOffset.UtcNow;
                    _segundosRestantesSesion = 20 * 60;
                    _sesionCerrada = false;
                }
                else if (_sesion.Estado == "Cerrada")
                {
                    _sesionCerrada = true;
                    _segundosRestantesSesion = 0;
                }
                else if (_sesion.Estado == "Suspendida")
                {
                    _sesionSuspendida = true;
                    _sesionCerrada = true;
                    _segundosRestantesSesion = 0;
                }
                else if (_sesion.Estado == "Abierta")
                {
                    var cacheState = await SessionCache.GetActiveSessionAsync(_sesion.Id);
                    if (cacheState != null && cacheState.EstaAbierta)
                    {
                        _horaInicioSesion = cacheState.InicioVigencia;
                    }
                    else
                    {
                        // Respetar la hora de apertura original de la sesión
                        _horaInicioSesion = _sesion.CreadoEn != DateTimeOffset.MinValue ? _sesion.CreadoEn : DateTimeOffset.UtcNow;
                    }

                    var transcurrido = (DateTimeOffset.UtcNow - _horaInicioSesion).TotalSeconds;
                    if (transcurrido >= 20 * 60)
                    {
                        _sesionCerrada = true;
                        _segundosRestantesSesion = 0;
                    }
                    else
                    {
                        _segundosRestantesSesion = Math.Max(0, (20 * 60) - (int)transcurrido);
                        _sesionCerrada = false;
                    }
                }

                _totalPresentes = _sesion.TotalPresentes;

                // Cargar estudiantes que ya registraron asistencia en esta sesión
                try
                {
                    var detalles = await DetalleRepo.ListarPorListaAsync(_sesion.Id);
                    var presentes = detalles
                        .Where(d => d.Estado == "Presente")
                        .OrderByDescending(d => d.HoraLlegada ?? DateTimeOffset.MinValue)
                        .Take(10)
                        .ToList();

                    _ultimosRegistrados.Clear();
                    var refLat = _latitudPersonalizada ?? _espacio?.Latitud;
                    var refLon = _longitudPersonalizada ?? _espacio?.Longitud;
                    foreach (var p in presentes)
                    {
                        var est = await EstudianteRepo.ObtenerPorIdAsync(p.EstudianteId);
                        if (est != null)
                        {
                            var horaStr = FormatearHoraLocal(p.HoraLlegada);
                            double? distCalc = null;
                            if (p.Latitud.HasValue && p.Longitud.HasValue && refLat.HasValue && refLon.HasValue)
                            {
                                distCalc = SuscripcionService.CalcularDistanciaMetros(p.Latitud.Value, p.Longitud.Value, refLat.Value, refLon.Value);
                            }
                            _ultimosRegistrados.Add(new AsistenteEnVivoModel
                            {
                                Nombre = est.NombreCompleto,
                                Codigo = est.Codigo,
                                Hora = horaStr,
                                Latitud = p.Latitud,
                                Longitud = p.Longitud,
                                PrecisionMetros = p.PrecisionGps,
                                DistanciaMetros = distCalc,
                                QrLatitud = refLat,
                                QrLongitud = refLon,
                                RadioPermitido = _radioToleranciaMetros,
                                Modo = _modoValidacion
                            });
                        }
                    }
                }
                catch
                {
                    // Manejo silencioso en fallback
                }
            }

            // Consultar solicitudes de revinculación pendientes
            var pendientes = await RevinculacionService.ListarPendientesPorMateriaAsync(MateriaId);
            _solicitudesRevinculacionPendientes = pendientes.Count;

            if (!_sesionCerrada && _sesion != null)
            {
                await RotarCodigoQrAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al iniciar la proyección: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatearHoraLocal(DateTimeOffset? fechaUtc)
    {
        return TimeHelper.FormatearHoraLocal(fechaUtc);
    }

    private async Task ReiniciarAsistenciaParaPruebasAsync()
    {
        if (_sesion == null) return;
        try
        {
            _loading = true;
            await DetalleRepo.EliminarPorListaAsync(_sesion.Id);
            _sesion.TotalPresentes = 0;
            _sesion.TotalFaltas = 0;
            await ListaRepo.CrearOActualizarAsync(_sesion);

            _totalPresentes = 0;
            _ultimosRegistrados.Clear();

            // Limpiar también solicitudes de revinculación de prueba para esta materia
            try
            {
                var pendientes = await RevinculacionService.ListarPendientesPorMateriaAsync(MateriaId);
                foreach (var p in pendientes)
                {
                    await RevinculacionRepo.MarcarComoUsadaAsync(p.Id);
                }
            }
            catch { /* Silencioso en pruebas */ }

            _solicitudesRevinculacionPendientes = 0;

            Snackbar.Add("Asistencia reiniciada a 0. Lista lista para nueva prueba de escaneo.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al reiniciar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ReabrirSesionAsync()
    {
        if (_sesion == null) return;

        try
        {
            _loading = true;
            _horaInicioSesion = DateTimeOffset.UtcNow;
            _segundosRestantesSesion = 20 * 60;
            _segundosRestantesRotacion = 15;
            _rotacion = 0;
            _sesionCerrada = false;
            _sesionSuspendida = false;

            await ListaRepo.ActualizarEstadoAsync(_sesion.Id, "Abierta");
            _sesion.Estado = "Abierta";

            await RotarCodigoQrAsync();

            if (_hubConnection != null && _hubConnection.State == HubConnectionState.Connected)
            {
                await _hubConnection.InvokeAsync("JoinClassroomSession", _sesion.Id.ToString());
            }

            Snackbar.Add("¡Sesión de asistencia abierta! El código QR está activo por 20 minutos.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al abrir la sesión: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task InicializarSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/attendance"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<AsistenciaTelemetriaDto>("AsistenciaRegistradaConTelemetria", (dto) =>
            {
                InvokeAsync(() =>
                {
                    _totalPresentes = dto.TotalPresentes;
                    _ultimosRegistrados.RemoveAll(x => x.Codigo == dto.Codigo);
                    _ultimosRegistrados.Insert(0, new AsistenteEnVivoModel
                    {
                        Nombre = dto.Nombre,
                        Codigo = dto.Codigo,
                        Hora = TimeHelper.Now.ToString("HH:mm:ss"),
                        Latitud = dto.Latitud,
                        Longitud = dto.Longitud,
                        PrecisionMetros = dto.PrecisionMetros,
                        DistanciaMetros = dto.DistanciaMetros,
                        QrLatitud = dto.QrLatitud,
                        QrLongitud = dto.QrLongitud,
                        RadioPermitido = dto.RadioPermitido,
                        Modo = dto.Modo
                    });
                    if (_ultimosRegistrados.Count > 10)
                    {
                        _ultimosRegistrados.RemoveAt(_ultimosRegistrados.Count - 1);
                    }
                    StateHasChanged();
                });
            });

            _hubConnection.On<string, string, int>("AsistenciaRegistrada", (estudianteNombre, estudianteCodigo, totalPresentes) =>
            {
                InvokeAsync(() =>
                {
                    _totalPresentes = totalPresentes;
                    if (!_ultimosRegistrados.Any(x => x.Codigo == estudianteCodigo))
                    {
                        _ultimosRegistrados.Insert(0, new AsistenteEnVivoModel
                        {
                            Nombre = estudianteNombre,
                            Codigo = estudianteCodigo,
                            Hora = TimeHelper.Now.ToString("HH:mm:ss"),
                            Modo = _modoValidacion,
                            RadioPermitido = _radioToleranciaMetros
                        });
                        if (_ultimosRegistrados.Count > 10)
                        {
                            _ultimosRegistrados.RemoveAt(_ultimosRegistrados.Count - 1);
                        }
                    }
                    StateHasChanged();
                });
            });

            _hubConnection.On<string>("SesionCerrada", (sesionIdStr) =>
            {
                if (_sesion != null && sesionIdStr == _sesion.Id.ToString())
                {
                    InvokeAsync(() =>
                    {
                        _sesionCerrada = true;
                        StateHasChanged();
                    });
                }
            });

            _hubConnection.On<string, string, string, string>("NuevaSolicitudRevinculacion", (solId, estNombre, estCodigo, hora) =>
            {
                InvokeAsync(() =>
                {
                    _solicitudesRevinculacionPendientes++;
                    Snackbar.Add($"⚠️ Solicitud de cambio de dispositivo: {estNombre} ({estCodigo})", Severity.Warning);
                    StateHasChanged();
                });
            });

            _hubConnection.On<string, string>("SesionSuspendida", (sesionIdStr, motivo) =>
            {
                if (_sesion != null && sesionIdStr == _sesion.Id.ToString())
                {
                    InvokeAsync(() =>
                    {
                        _sesionSuspendida = true;
                        _sesionCerrada = true;
                        Snackbar.Add($"Clase suspendida de emergencia: {motivo}", Severity.Error);
                        StateHasChanged();
                    });
                }
            });

            await _hubConnection.StartAsync();

            if (_sesion != null)
            {
                await _hubConnection.InvokeAsync("JoinClassroomSession", _sesion.Id.ToString());
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Conexión en tiempo real degradada: {ex.Message}", Severity.Warning);
        }
    }

    private void IniciarTemporizadorCiclo()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = Task.Run(async () =>
        {
            while (!_cts.Token.IsCancellationRequested && _timer != null && await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_sesionCerrada)
                    {
                        return;
                    }

                    // Decrementar rotación (15s) solo en modo dinámico
                    if (!_qrEstaticoUnico)
                    {
                        _segundosRestantesRotacion--;
                        if (_segundosRestantesRotacion <= 0)
                        {
                            _rotacion++;
                            _segundosRestantesRotacion = 15;
                            await RotarCodigoQrAsync();
                        }
                    }

                    // Decrementar tiempo total de apertura (20 min)
                    _segundosRestantesSesion--;
                    if (_segundosRestantesSesion <= 0)
                    {
                        await FinalizarSesionAsync();
                    }

                    StateHasChanged();
                });
            }
        }, _cts.Token);
    }

    private async Task RotarCodigoQrAsync()
    {
        if (_sesion == null) return;

        try
        {
            int rotacionIndexParaToken;
            if (_qrEstaticoUnico)
            {
                rotacionIndexParaToken = -1; // -1 indica QR Único / Estático sin caducidad por rotación
            }
            else
            {
                var segundosDesdeInicio = Math.Max(0, (int)(DateTimeOffset.UtcNow - _horaInicioSesion).TotalSeconds);
                _rotacion = segundosDesdeInicio / 15;
                rotacionIndexParaToken = _rotacion;
            }

            var tokenString = TokenService.GenerateSessionQrToken(
                _sesion.Id,
                _sesion.InstitucionId,
                _horaInicioSesion,
                ventanaMinutos: _minutosCaducidad,
                rotacionIndex: rotacionIndexParaToken);

            var baseUrl = !string.IsNullOrWhiteSpace(_servidorBasePersonalizado)
                ? _servidorBasePersonalizado.TrimEnd('/')
                : (Navigation.BaseUri.Contains("localhost") || Navigation.BaseUri.Contains("127.0.0.1")
                    ? _ipLocalSugerida
                    : Navigation.BaseUri.TrimEnd('/'));

            // Mantener el esquema real de la aplicación (http o https según el hosting) sin forzar SSL si el servidor no lo soporta
            if (Navigation.BaseUri.StartsWith("https://", StringComparison.OrdinalIgnoreCase) && baseUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !baseUrl.Contains("192.168.") && !baseUrl.Contains("10."))
            {
                baseUrl = "https://" + baseUrl.Substring(7);
            }

            var modoParam = _modoValidacion == "wifi" 
                ? "&modo=wifi" 
                : (_modoValidacion == "proximidad" ? "&modo=proximidad" : "&modo=gps");
            modoParam += $"&r={_radioToleranciaMetros}";
            var refLat = _latitudPersonalizada ?? _espacio?.Latitud ?? -17.776200;
            var refLon = _longitudPersonalizada ?? _espacio?.Longitud ?? -63.195100;
            if (_modoValidacion != "wifi")
            {
                modoParam += $"&clat={refLat.ToString(System.Globalization.CultureInfo.InvariantCulture)}&clon={refLon.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
            }
            _urlEscaneoActual = $"{baseUrl}/a/{_sesion.Id}?t={tokenString}{modoParam}";
            _qrSvgContent = QrService.GenerateSvg(_urlEscaneoActual, pixelsPerModule: 10, darkColorHex: "#0F172A", lightColorHex: "#FFFFFF");

            // Actualizar caché de Redis para consistencia
            var estado = new SessionEphemeralState
            {
                SesionId = _sesion.Id,
                InstitucionId = _sesion.InstitucionId,
                MateriaId = _sesion.MateriaId,
                DocenteId = _sesion.DocenteId != Guid.Empty ? _sesion.DocenteId : (_materia?.DocenteId ?? Guid.Empty),
                InicioVigencia = _horaInicioSesion,
                Vencimiento = _horaInicioSesion.AddMinutes(_minutosCaducidad),
                RotacionIndex = rotacionIndexParaToken,
                TokenActual = tokenString,
                ContadorAsistentes = _totalPresentes,
                EstaAbierta = true
            };
            await SessionCache.SetActiveSessionAsync(estado, TimeSpan.FromMinutes(_minutosCaducidad));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al rotar código QR: {ex.Message}", Severity.Warning);
        }
    }

    private async Task CopiarEnlacePruebaAsync()
    {
        if (string.IsNullOrWhiteSpace(_urlEscaneoActual)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _urlEscaneoActual);
            Snackbar.Add("¡Enlace de alumno copiado al portapapeles! Pégalo en otra pestaña o ventana de incógnito para probar.", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"Enlace: {_urlEscaneoActual}", Severity.Info);
        }
    }

    private async Task CambiarHostBaseAsync(string nuevoHost)
    {
        _servidorBasePersonalizado = nuevoHost;
        await RotarCodigoQrAsync();
        var hostNombre = string.IsNullOrWhiteSpace(nuevoHost) ? "Localhost (PC)" : nuevoHost;
        Snackbar.Add($"Destino QR configurado a: {hostNombre}", Severity.Info);
        StateHasChanged();
    }

    private async Task FinalizarSesionAsync()
    {
        if (_sesion == null) return;

        _sesionCerrada = true;
        await ListaRepo.ActualizarEstadoAsync(_sesion.Id, "Cerrada", DateTime.Now.TimeOfDay);
        await SessionCache.InvalidateSessionAsync(_sesion.Id);

        try
        {
            var instId = _materia?.InstitucionId ?? _sesion.InstitucionId;
            var estudiantesSuscritos = await SuscripcionRepo.ListarEstudiantesIdsPorMateriaAsync(MateriaId);
            var registrosAsistencia = await DetalleRepo.ListarPorListaAsync(_sesion.Id);
            var presentesIds = new HashSet<Guid>(registrosAsistencia.Where(r => r.Estado == "Presente").Select(r => r.EstudianteId));
            var ausentesIds = estudiantesSuscritos.Where(id => !presentesIds.Contains(id)).ToList();

            var faltasRegistradas = await DetalleRepo.RegistrarFaltasIdempotenteAsync(
                _sesion.Id,
                instId,
                ausentesIds);

            var totalPresentes = presentesIds.Count;
            var totalFaltas = registrosAsistencia.Count(r => r.Estado == "Falta") + faltasRegistradas;
            await ListaRepo.ActualizarTotalesAsync(_sesion.Id, estudiantesSuscritos.Count, totalPresentes, totalFaltas);
            Snackbar.Add($"Sesión cerrada: {totalPresentes} presentes, {totalFaltas} faltas computadas.", Severity.Info);
        }
        catch
        {
            Snackbar.Add($"La ventana de asistencia ha cerrado.", Severity.Info);
        }
    }

    private async Task CerrarAsistenciaManualmente()
    {
        await FinalizarSesionAsync();
        StateHasChanged();
    }

    private async Task AbrirDialogoRevinculaciones()
    {
        var parameters = new DialogParameters<RevinculacionDialog>
        {
            { x => x.MateriaId, MateriaId },
            { x => x.DocenteNombre, _materia?.NombreDocente ?? "Docente Titular" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RevinculacionDialog>("Revinculación de Dispositivos", parameters, options);
        await dialog.Result;

        var pendientes = await RevinculacionService.ListarPendientesPorMateriaAsync(MateriaId);
        _solicitudesRevinculacionPendientes = pendientes.Count;
        StateHasChanged();
    }

    private async Task AbrirDialogoSuspensionEmergencia()
    {
        if (_sesion == null) return;

        var parameters = new DialogParameters<SuspensionClaseDialog>
        {
            { x => x.ListaId, _sesion.Id },
            { x => x.DocenteNombre, _materia?.NombreDocente ?? "Docente Titular" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SuspensionClaseDialog>("Suspender Clase de Emergencia", parameters, options);
        var res = await dialog.Result;
        if (res != null && !res.Canceled)
        {
            _sesionSuspendida = true;
            _sesionCerrada = true;
            StateHasChanged();
        }
    }

