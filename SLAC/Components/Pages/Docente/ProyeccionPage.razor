        var transcurrido = (DateTimeOffset.UtcNow - _horaInicioSesion).TotalSeconds;
        _segundosRestantesSesion = Math.Max(0, _segundosTotalesSesion - (int)transcurrido);

        if (_espacio != null)
        {
            _espacio.RadioMetros = _radioToleranciaMetros;
            if (_latitudPersonalizada.HasValue && _longitudPersonalizada.HasValue)
