            _sesion.TotalPresentes = 0;
            _sesion.TotalFaltas = 0;
            await ListaRepo.CrearOActualizarAsync(_sesion);

            _totalPresentes = 0;
            _ultimosRegistrados.Clear();

            Snackbar.Add("Asistencia reiniciada a 0. Lista lista para nueva prueba de escaneo.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al reiniciar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ReabrirSesionAsync()
