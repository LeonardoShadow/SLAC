@page "/proyeccion/{materiaId:guid}"
@page "/docente/proyeccion/{materiaId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using SLAC.Core.Attendance.Entities
@using SLAC.Core.Attendance.Repositories
@using SLAC.Core.Docentes.Entities
@using SLAC.Core.Docentes.Repositories
@using SLAC.Core.Institucional.Entities
@using SLAC.Core.Institucional.Repositories
@using SLAC.Core.Security
@using SLAC.Core.Session
@using SLAC.Core.Session.Models
@using SLAC.Core.Attendance.Services
@using SLAC.Features.Attendance.Services
@using SLAC.Core.Estudiantes.Entities
@using SLAC.Core.Estudiantes.Repositories
@inject IMateriaRepository MateriaRepo
@inject IEspacioRepository EspacioRepo
@inject IListaAsistenciaRepository ListaRepo
@inject IAsistenciaDetalleRepository DetalleRepo
@inject IEstudianteRepository EstudianteRepo
@inject ISuscripcionRepository SuscripcionRepo
@inject ITokenService TokenService
@inject IQrCodeGeneratorService QrService
@inject ISessionCacheRepository SessionCache
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IRevinculacionService RevinculacionService
@inject ICorreccionAsistenciaService CorreccionService
@inject IDialogService DialogService

<PageTitle>SLAC - Proyección de Asistencia en Sala</PageTitle>

<div class="proyeccion-container">
    <!-- Header Superior -->
    <header class="proyeccion-header">
        <div class="header-left">
            <div class="brand-badge">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" Size="Size.Small" />
                <span>SLAC &bull; PROYECCIÓN DE AULA</span>
            </div>
            <h1 class="materia-title">@(_materia?.Nombre ?? "Cargando materia...")</h1>
            <div class="materia-meta">
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Class="mr-1" />@(_materia?.Codigo)</span>
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" Class="mr-1" />@(_espacio?.Nombre ?? "Aula")</span>
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />@(_materia?.HoraInicio.ToString(@"hh\:mm")) hrs</span>
            </div>
        </div>

        <div class="header-right">
            <div class="live-clock">
                <span class="clock-time">@_horaActualString</span>
                <span class="clock-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
            </div>

            <div class="header-actions">
                <MudTooltip Text="Ajustes de Sesión (GPS / Wi-Fi, Alcance y Duración)">
                    <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                   Color="Color.Primary"
                                   OnClick="@(() => _mostrarAjustesModal = true)"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Iniciar / Reabrir Sesión QR">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Success"
                                   OnClick="ReabrirSesionAsync"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Alternar Pantalla Completa (F11)">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                   Color="Color.Inherit"
                                   OnClick="AlternarPantallaCompleta"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Ver Reporte de Faltas">
                    <MudIconButton Icon="@Icons.Material.Filled.Assessment"
                                   Color="Color.Inherit"
                                   OnClick="IrAReportes"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Volver a Materias">
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Inherit"
                                   OnClick="VolverAMaterias"
                                   Class="action-btn" />
                </MudTooltip>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="loading-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <p class="mt-4 text-muted">Inicializando sesión de aula y criptografía ES256...</p>
        </div>
    }
    else if (_sesionCerrada)
    {
        <div class="session-closed-card">
            <div class="closed-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Success" />
            </div>
            <h2>Sesión de Asistencia Finalizada</h2>
            <p class="closed-desc">
                La ventana de 20 minutos de esta sesión ha concluido. Si deseas proyectar el código QR para el aula en este momento, puedes iniciar o reabrir la ventana de asistencia ahora.
            </p>
            <div class="closed-stats">
                <div class="stat-pill">
                    <span class="stat-num">@_totalPresentes</span>
                    <span class="stat-lbl">Presentes Registrados</span>
                </div>
            </div>
            <div class="d-flex gap-4 mt-6 flex-wrap justify-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="ReabrirSesionAsync"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Size="Size.Large"
                           Class="px-6 py-3"
                           Style="font-weight: 700; font-size: 1rem; border-radius: 12px; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);">
                    Iniciar / Reabrir Sesión QR (20 min)
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IrAReportes" StartIcon="@Icons.Material.Filled.Summarize" Class="py-3">
                    Ver Reporte de Faltas
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="VolverAMaterias" Class="py-3">
                    Volver al Panel
                </MudButton>
            </div>
        </div>
    }
    else
    {
        @if (_sesionSuspendida)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Icon="@Icons.Material.Filled.WarningAmber">
                <b>CLASE SUSPENDIDA DE EMERGENCIA:</b> La sesión ha sido cancelada por el docente. No se computarán faltas oficiales a los alumnos ausentes de esta sesión.
            </MudAlert>
        }

        <!-- Contenido Principal: QR + Panel de Información en Vivo -->
        <main class="proyeccion-body">
            <!-- Columna Izquierda: Tarjeta QR Dinámica -->
            <section class="qr-section">
                <div class="qr-card">
                    <!-- Status Banner -->
                    <div class="qr-status-bar">
                        <div class="status-pulse">
                            <span class="pulse-dot"></span>
                            <span class="status-text">SESIÓN ACTIVA &bull; ESCANEO ABIERTO</span>
                        </div>
                        <div class="rotation-timer">
                            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="mr-1 spin-icon" />
                            <span>Rotación en <b>@_segundosRestantesRotacion s</b></span>
                        </div>
                    </div>

                    <!-- Código QR Vectorial SVG -->
                    <div class="qr-canvas-wrapper">
                        @if (!string.IsNullOrEmpty(_qrSvgContent))
                        {
                            <div class="qr-svg-container">
                                @((MarkupString)_qrSvgContent)
                            </div>
                        }
                        else
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                    </div>

                    <!-- Barra de progreso de rotación (15s) -->
                    <div class="rotation-progress-bar">
                        <div class="progress-fill" style="width: @(_porcentajeRotacion)%;"></div>
                    </div>

                    <!-- Instrucción para el estudiante -->
                    <div class="qr-footer-instruction">
                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" Class="mr-2 text-primary" />
                        <span>Apunta la cámara de tu teléfono móvil hacia la pantalla para registrar tu asistencia.</span>
                    </div>

                    <!-- Herramientas de Conectividad y Prueba para el Docente -->
                    <div class="mt-3 pa-3" style="background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.08);">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">
                                <MudIcon Icon="@Icons.Material.Filled.QrCode" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                Enlace de Escaneo Estudiante
                            </span>
                            <span style="font-size: 0.75rem; color: #34d399;">● Activo</span>
                        </div>

                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="CopiarEnlacePruebaAsync">
                                Copiar Enlace Alumno (PC)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       Target="_blank"
                                       Href="@_urlEscaneoActual"
                                       StartIcon="@Icons.Material.Filled.OpenInNew">
                                Abrir Enlace en Pestaña Nueva
                            </MudButton>
                        </div>

                        <!-- Selector de Red: Wi-Fi Móvil vs Localhost -->
                        <div class="d-flex align-center gap-2 mt-2 pt-2 flex-wrap" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <span style="font-size: 0.75rem; color: #94a3b8;">Destino QR:</span>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == _ipLocalSugerida ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Success"
                                     OnClick="@(() => CambiarHostBaseAsync(_ipLocalSugerida))">
                                📱 Wi-Fi HTTP (5257)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == "https://192.168.0.18:7213" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Warning"
                                     OnClick="@(() => CambiarHostBaseAsync("https://192.168.0.18:7213"))">
                                🔒 Wi-Fi HTTPS (7213)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == "http://localhost:5257" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Default"
                                     OnClick="@(() => CambiarHostBaseAsync("http://localhost:5257"))">
                                💻 Localhost (PC)
                            </MudChip>
                        </div>

                        <!-- Selector Rápido: Modo Wi-Fi vs GPS y Alcance -->
                        <div class="d-flex align-center gap-2 mt-2 pt-2 flex-wrap" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <span style="font-size: 0.75rem; color: #94a3b8;">Modo:</span>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_modoValidacion == "wifi" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Success"
                                     Icon="@Icons.Material.Filled.Wifi"
                                     OnClick="@(() => AlternarModoValidacionAsync("wifi"))">
                                📶 Solo Wi-Fi / QR
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_modoValidacion == "gps" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Info"
                                     Icon="@Icons.Material.Filled.GpsFixed"
                                     OnClick="@(() => AlternarModoValidacionAsync("gps"))">
                                📍 GPS Obligatorio (@(_radioToleranciaMetros)m)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Tune"
                                     OnClick="@(() => _mostrarAjustesModal = true)">
                                ⏱️ @(_minutosCaducidad) min | ⚙️ Ajustar
                            </MudChip>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Columna Derecha: Métricas y Feed en Vivo -->
            <aside class="metrics-section">
                <!-- Tarjeta Contador Asistentes -->
                <div class="metric-card counter-card">
                    <div class="counter-header">
                        <span class="metric-lbl">ESTUDIANTES EN AULA</span>
                        <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <div class="counter-value">
                        <span class="big-number">@_totalPresentes</span>
                        <span class="counter-badge">Alumnos Registrados</span>
                    </div>
                </div>

                <!-- Tarjeta Temporizador Sesión 20 min -->
                <div class="metric-card timer-card">
                    <div class="counter-header">
                        <span class="metric-lbl">TIEMPO RESTANTE DE ASISTENCIA</span>
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Size="Size.Medium" />
                    </div>
                    <div class="timer-display">
                        <span class="timer-digits">@_tiempoRestanteSesionString</span>
                        <span class="timer-desc">Cierre automático a los 20 min</span>
                    </div>
                    <MudProgressLinear Color="Color.Warning"
                                       Value="@_porcentajeTiempoSesion"
                                       Rounded="true"
                                       Class="my-2"
                                       Size="Size.Medium" />
                </div>

                <!-- Feed en Vivo de Últimos Registros -->
                <div class="metric-card feed-card">
                    <div class="feed-header">
                        <div class="d-flex align-center gap-2">
                            <span class="feed-dot"></span>
                            <span class="metric-lbl">ASISTENCIA EN VIVO</span>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="Reiniciar asistencias de prueba a 0 para volver a escanear">
                                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="ReiniciarAsistenciaParaPruebasAsync" />
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">SignalR Conectado</MudText>
                        </div>
                    </div>

                    <div class="feed-list">
                        @if (_ultimosRegistrados.Count == 0)
                        {
                            <div class="feed-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Large" Class="mb-2 text-muted" />
                                <p>Esperando los primeros escaneos...</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var reg in _ultimosRegistrados)
                            {
                                <div class="feed-item slide-in">
                                    <div class="feed-item-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </div>
                                    <div class="feed-item-info">
                                        <span class="feed-item-name">@reg.Nombre</span>
                                        <span class="feed-item-code">@reg.Codigo &bull; @reg.Hora</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Acciones del Docente: Revinculación, Suspensión y Cierre -->
                <div class="actions-card d-flex flex-column gap-2">
                    <MudBadge Content="@_solicitudesRevinculacionPendientes"
                              Color="Color.Warning"
                              Overlap="true"
                              Visible="@(_solicitudesRevinculacionPendientes > 0)"
                              Class="w-100">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.PhonelinkLock"
                                   OnClick="AbrirDialogoRevinculaciones"
                                   Class="py-2">
                            Revinculación de Dispositivos (@_solicitudesRevinculacionPendientes)
                        </MudButton>
                    </MudBadge>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.ReportProblem"
                               OnClick="AbrirDialogoSuspensionEmergencia"
                               Class="py-2">
                        Suspender Clase (Emergencia)
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.LockClock"
                               OnClick="CerrarAsistenciaManualmente"
                               Class="py-2">
                        Cerrar Asistencia Ahora
                    </MudButton>
                </div>
            </aside>
        </main>
    }

    <!-- Modal Flotante de Ajustes de Sesión (Tiempo, Modo y Alcance) -->
    @if (_mostrarAjustesModal)
    {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.78); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 1.25rem;">
            <div style="background: #0f172a; border: 1px solid rgba(255,255,255,0.15); border-radius: 1.5rem; padding: 2rem; width: 100%; max-width: 520px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8);">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: #fff;">
                        ⚙️ Ajustes de Sesión y Asistencia
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="@(() => _mostrarAjustesModal = false)" />
                </div>

                <!-- 1. Modo de Asistencia -->
                <div class="mb-4">
                    <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                        Modo de Validación Requerido:
                    </label>
                    <div class="d-flex gap-2">
                        <MudButton Variant="@(_modoValidacion == "wifi" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Wifi"
                                   OnClick="@(() => _modoValidacion = "wifi")"
                                   Class="flex-grow-1 py-2">
                            📶 Solo Wi-Fi / QR
                        </MudButton>
                        <MudButton Variant="@(_modoValidacion == "gps" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.GpsFixed"
                                   OnClick="@(() => _modoValidacion = "gps")"
                                   Class="flex-grow-1 py-2">
                            📍 GPS Obligatorio
                        </MudButton>
                    </div>
                    <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-top: 0.35rem;">
                        @(_modoValidacion == "wifi" 
                            ? "✅ Recomendado para pruebas en localhost o red interna en la Universidad (no bloquea navegador móvil)." 
                            : "🛰️ Exige al navegador móvil activar GPS y estar físicamente dentro del radio del aula.")
                    </span>
                </div>

                <!-- 2. Tiempo de Caducidad de la Sesión -->
                <div class="mb-4">
                    <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                        Tiempo de Caducidad / Ventana de Sesión (Minutos):
                    </label>
                    <MudNumericField T="int" @bind-Value="_minutosCaducidad" Min="1" Max="240" Step="5"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     HelperText="Tiempo total que la sesión permanecerá abierta para escaneo (actualiza el temporizador)." />
                </div>

                <!-- 3. Alcance de Ubicación (Radio de Tolerancia en Metros) -->
                @if (_modoValidacion == "gps")
                {
                    <div class="mb-4">
                        <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                            Alcance de Ubicación GPS (Tolerancia en Metros):
                        </label>
                        <MudNumericField T="int" @bind-Value="_radioToleranciaMetros" Min="20" Max="5000" Step="50"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HelperText="Distancia máxima permitida entre el estudiante y el aula (ej. 300m campus universitario)." />
                    </div>
                }

                <div class="d-flex justify-end gap-2 mt-6">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => _mostrarAjustesModal = false)">
                        Cancelar
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAjustesSesionAsync" StartIcon="@Icons.Material.Filled.Save">
                        Aplicar Ajustes
                    </MudButton>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .proyeccion-container {
        min-height: 100vh;
        background: radial-gradient(circle at 50% 10%, #1e1b4b 0%, #090d16 80%);
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        padding: 1.5rem 2rem;
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    .proyeccion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .brand-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        padding: 0.3rem 0.85rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .materia-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.35rem;
        line-height: 1.2;
    }

    .materia-meta {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .meta-tag {
        display: inline-flex;
        align-items: center;
        font-size: 0.875rem;
        color: #94a3b8;
        background: rgba(255, 255, 255, 0.04);
        padding: 0.25rem 0.65rem;
        border-radius: 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .live-clock {
        text-align: right;
    }

    .clock-time {
        display: block;
        font-size: 1.75rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: #f1f5f9;
        line-height: 1.1;
    }

    .clock-date {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: capitalize;
    }

    .header-actions {
        display: flex;
        gap: 0.5rem;
    }

    .action-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
    }

    .proyeccion-body {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 2rem;
        flex: 1;
        align-items: stretch;
    }

    @@media (max-width: 960px) {
        .proyeccion-body {
            grid-template-columns: 1fr;
        }
    }

    .qr-section {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .qr-card {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 2rem;
        padding: 2rem;
        width: 100%;
        max-width: 540px;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 50px -10px rgba(99, 102, 241, 0.25);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .qr-status-bar {
