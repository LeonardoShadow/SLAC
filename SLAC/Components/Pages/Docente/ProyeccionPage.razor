            : "🔄 Modo 'QR Dinámico' activado: El código QR rotará automáticamente cada 15 segundos.",
            Severity.Info);
    }

    private async Task CalibrarUbicacionDocenteAsync()
    {
        try
        {
            _calibrandoGps = true;
            _calibracionMensaje = "Obteniendo ubicación del dispositivo...";
            StateHasChanged();

            var coords = await JS.InvokeAsync<double[]>("slacGetDocenteLocation");
            if (coords != null && coords.Length >= 2)
            {
                _latitudPersonalizada = coords[0];
                _longitudPersonalizada = coords[1];
                _coordenadasPuntoATexto = $"{coords[0].ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}, {coords[1].ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";
                var acc = coords.Length >= 3 ? coords[2] : 0;

                if (acc > 100)
                {
                    _calibracionMargenErrorPc = acc;
                    _calibracionMensaje = $"📍 Aula fijada por red PC ({coords[0]:F4}, {coords[1]:F4}) con margen de ~{acc:F0}m (las computadoras no tienen antena GPS satelital).";
                    if (_radioToleranciaMetros < (int)acc)
                    {
                        _radioToleranciaMetros = (int)acc + 100;
                    }
                }
                else
                {
                    _calibracionMargenErrorPc = 0;
                    _calibracionMensaje = $"✅ Aula fijada por satélite: {coords[0]:F4}, {coords[1]:F4} (Precisión: {acc:F0}m)";
                }

                if (_espacio != null)
                {
                    _espacio.Latitud = coords[0];
                    _espacio.Longitud = coords[1];
                }
                await RotarCodigoQrAsync();
                Snackbar.Add("¡Ubicación del aula calibrada con éxito!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            _calibracionMensaje = "⚠️ No se pudo obtener el GPS: " + ex.Message;
            Snackbar.Add("No se pudo obtener la posición del docente: " + ex.Message, Severity.Warning);
        }
        finally
        {
            _calibrandoGps = false;
            StateHasChanged();
        }
    }

    private async Task AlternarModoValidacionAsync(string nuevoModo)
    {
        _modoValidacion = nuevoModo;
