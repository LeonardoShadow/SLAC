    private static string FormatearHoraLocal(DateTimeOffset? fechaUtc)
    {
        if (!fechaUtc.HasValue) return DateTime.Now.ToString("HH:mm:ss");
        var utc = fechaUtc.Value.UtcDateTime;
        return TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.Local).ToString("HH:mm:ss");
    }

    private async Task ReiniciarAsistenciaParaPruebasAsync()
