@page "/proyeccion/{materiaId:guid}"
@page "/docente/proyeccion/{materiaId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using SLAC.Core.Attendance.Entities
@using SLAC.Core.Attendance.Repositories
@using SLAC.Core.Docentes.Entities
@using SLAC.Core.Docentes.Repositories
@using SLAC.Core.Institucional.Entities
@using SLAC.Core.Institucional.Repositories
@using SLAC.Core.Security
@using SLAC.Core.Session
@using SLAC.Core.Session.Models
@using SLAC.Core.Attendance.Services
@using SLAC.Features.Attendance.Services
@using SLAC.Core.Estudiantes.Entities
@using SLAC.Core.Estudiantes.Repositories
@inject IMateriaRepository MateriaRepo
@inject IEspacioRepository EspacioRepo
@inject IListaAsistenciaRepository ListaRepo
@inject IAsistenciaDetalleRepository DetalleRepo
@inject IEstudianteRepository EstudianteRepo
@inject ISuscripcionRepository SuscripcionRepo
@inject ITokenService TokenService
@inject IQrCodeGeneratorService QrService
@inject ISessionCacheRepository SessionCache
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IRevinculacionService RevinculacionService
@inject IRevinculacionRepository RevinculacionRepo
@inject ICorreccionAsistenciaService CorreccionService
@inject IDialogService DialogService

<PageTitle>SLAC - Proyección de Asistencia en Sala</PageTitle>

<div class="proyeccion-container">
    <!-- Header Superior -->
    <header class="proyeccion-header">
        <div class="header-left">
            <div class="brand-badge">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" Size="Size.Small" />
                <span>SLAC &bull; PROYECCIÓN DE AULA</span>
            </div>
            <h1 class="materia-title">@(_materia?.Nombre ?? "Cargando materia...")</h1>
            <div class="materia-meta">
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Class="mr-1" />@(_materia?.Codigo)</span>
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" Class="mr-1" />@(_espacio?.Nombre ?? "Aula")</span>
                <span class="meta-tag"><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />@(_materia?.HoraInicio.ToString(@"hh\:mm")) hrs</span>
            </div>
        </div>

        <div class="header-right">
            <div class="live-clock">
                <span class="clock-time">@_horaActualString</span>
                <span class="clock-date">@TimeHelper.FormatearFechaLarga(TimeHelper.Today)</span>
            </div>

            <div class="header-actions">
                <MudTooltip Text="Ajustes de Sesión (GPS / Wi-Fi, Alcance y Duración)">
                    <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                   Color="Color.Primary"
                                   OnClick="@(() => _mostrarAjustesModal = true)"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Iniciar / Reabrir Sesión QR">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Success"
                                   OnClick="ReabrirSesionAsync"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Expandir QR a Pantalla Completa">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                   Color="Color.Primary"
                                   OnClick="AbrirQRPantallaCompleta"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Ver Reporte de Faltas">
                    <MudIconButton Icon="@Icons.Material.Filled.Assessment"
                                   Color="Color.Inherit"
                                   OnClick="IrAReportes"
                                   Class="action-btn" />
                </MudTooltip>
                <MudTooltip Text="Volver a Materias">
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Inherit"
                                   OnClick="VolverAMaterias"
                                   Class="action-btn" />
                </MudTooltip>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="loading-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <p class="mt-4 text-muted">Inicializando sesión de aula y criptografía ES256...</p>
        </div>
    }
    else if (_sesionCerrada)
    {
        <div class="session-closed-card">
            <div class="closed-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Success" />
            </div>
            <h2>Sesión de Asistencia Finalizada</h2>
            <p class="closed-desc">
                La ventana de 20 minutos de esta sesión ha concluido. Si deseas proyectar el código QR para el aula en este momento, puedes iniciar o reabrir la ventana de asistencia ahora.
            </p>
            <div class="closed-stats">
                <div class="stat-pill">
                    <span class="stat-num">@_totalPresentes</span>
                    <span class="stat-lbl">Presentes Registrados</span>
                </div>
            </div>
            <div class="d-flex gap-4 mt-6 flex-wrap justify-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="ReabrirSesionAsync"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Size="Size.Large"
                           Class="px-6 py-3"
                           Style="font-weight: 700; font-size: 1rem; border-radius: 12px; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);">
                    Iniciar / Reabrir Sesión QR (20 min)
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IrAReportes" StartIcon="@Icons.Material.Filled.Summarize" Class="py-3">
                    Ver Reporte de Faltas
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="VolverAMaterias" Class="py-3">
                    Volver al Panel
                </MudButton>
            </div>
        </div>
    }
    else
    {
        @if (_sesionSuspendida)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Icon="@Icons.Material.Filled.WarningAmber">
                <b>CLASE SUSPENDIDA DE EMERGENCIA:</b> La sesión ha sido cancelada por el docente. No se computarán faltas oficiales a los alumnos ausentes de esta sesión.
            </MudAlert>
        }

        <!-- Contenido Principal: QR + Panel de Información en Vivo -->
        <main class="proyeccion-body">
            <!-- Columna Izquierda: Tarjeta QR Dinámica -->
            <section class="qr-section">
                <div class="qr-card">
                    <!-- Status Banner -->
                    <div class="qr-status-bar">
                        <div class="status-pulse">
                            <span class="pulse-dot"></span>
                            <span class="status-text">SESIÓN ACTIVA &bull; @(_qrEstaticoUnico ? "QR ÚNICO FIJO" : "ESCANEO ABIERTO")</span>
                        </div>
                        <div class="d-flex align-center gap-2">
                            @if (!_qrEstaticoUnico)
                            {
                                <div class="rotation-timer">
                                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="mr-1 spin-icon" />
                                    <span>Rotación en <b>@_segundosRestantesRotacion s</b></span>
                                </div>
                            }
                            else
                            {
                                <div class="rotation-timer" style="color: #f59e0b; font-weight: 700;">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                                    <span>QR Único Fijo</span>
                                </div>
                            }
                            <MudTooltip Text="@(_qrEstaticoUnico ? "Cambiar a QR dinámico con rotación cada 15s" : "Fijar un único QR para toda la clase (sin rotación)")">
                                <MudIconButton Icon="@(_qrEstaticoUnico ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                               Size="Size.Small"
                                               Color="@(_qrEstaticoUnico ? Color.Warning : Color.Default)"
                                               OnClick="AlternarQREstaticoAsync" />
                            </MudTooltip>
                        </div>
                    </div>

                    <!-- Código QR Vectorial SVG -->
                    <div class="qr-canvas-wrapper">
                        @if (!string.IsNullOrEmpty(_qrSvgContent))
                        {
                            <div class="qr-svg-container">
                                @((MarkupString)_qrSvgContent)
                            </div>
                        }
                        else
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                    </div>

                    <!-- Barra de progreso de rotación (15s) -->
                    <div class="rotation-progress-bar">
                        <div class="progress-fill" style="width: @(_porcentajeRotacion)%; background: @(_qrEstaticoUnico ? "linear-gradient(90deg, #f59e0b, #10b981)" : "linear-gradient(90deg, #4f46e5, #06b6d4)");"></div>
                    </div>

                    <!-- Instrucción para el estudiante -->
                    <div class="qr-footer-instruction">
                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" Class="mr-2 text-primary" />
                        <span>Apunta la cámara de tu teléfono móvil hacia la pantalla para registrar tu asistencia.</span>
                    </div>

                    <!-- Botón Prominente PROYECTAR YA (Overlay de pantalla completa con botón X) -->
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CastConnected"
                               OnClick="AbrirQRPantallaCompleta"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="my-3 py-3"
                               Style="font-weight: 800; font-size: 1.15rem; background: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%); border-radius: 14px; box-shadow: 0 4px 20px rgba(37, 99, 235, 0.45); text-transform: uppercase; letter-spacing: 0.5px;">
                        PROYECTAR YA (PANTALLA COMPLETA)
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               OnClick="AbrirVentanaExternaProyector"
                               FullWidth="true"
                               Size="Size.Medium"
                               Class="mb-3 py-2"
                               Style="font-weight: 700; border-radius: 10px;">
                        📺 Abrir en Segunda Pantalla / Proyector (Ventana Limpia)
                    </MudButton>

                    <!-- Herramientas de Conectividad y Prueba para el Docente -->
                    <div class="mt-3 pa-3" style="background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.08);">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">
                                <MudIcon Icon="@Icons.Material.Filled.QrCode" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                Enlace de Escaneo Estudiante
                            </span>
                            <span style="font-size: 0.75rem; color: #34d399;">● Activo</span>
                        </div>

                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="CopiarEnlacePruebaAsync">
                                Copiar Enlace Alumno (PC)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       Target="_blank"
                                       Href="@_urlEscaneoActual"
                                       StartIcon="@Icons.Material.Filled.OpenInNew">
                                Abrir Enlace en Pestaña Nueva
                            </MudButton>
                        </div>

                        <!-- Selector de Red: Wi-Fi Móvil vs Localhost -->
                        <div class="d-flex align-center gap-2 mt-2 pt-2 flex-wrap" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <span style="font-size: 0.75rem; color: #94a3b8;">Destino QR:</span>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == _ipLocalSugerida ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Success"
                                     OnClick="@(() => CambiarHostBaseAsync(_ipLocalSugerida))">
                                📱 Wi-Fi HTTP (5257)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == "https://192.168.0.18:7213" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Warning"
                                     OnClick="@(() => CambiarHostBaseAsync("https://192.168.0.18:7213"))">
                                🔒 Wi-Fi HTTPS (7213)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_servidorBasePersonalizado == "http://localhost:5257" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Default"
                                     OnClick="@(() => CambiarHostBaseAsync("http://localhost:5257"))">
                                💻 Localhost (PC)
                            </MudChip>
                        </div>

                        <!-- Selector Rápido: 3 Modos de Validación, Alcance y QR Único -->
                        <div class="d-flex align-center gap-2 mt-2 pt-2 flex-wrap" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <span style="font-size: 0.75rem; color: #94a3b8;">Modo:</span>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_modoValidacion == "wifi" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Success"
                                     Icon="@Icons.Material.Filled.Wifi"
                                     OnClick="@(() => AlternarModoValidacionAsync("wifi"))">
                                📶 Solo Wi-Fi
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_modoValidacion == "proximidad" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Science"
                                     OnClick="@(() => AlternarModoValidacionAsync("proximidad"))">
                                🧪 GPS Experimental (@(_radioToleranciaMetros)m)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_modoValidacion == "gps" ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Info"
                                     Icon="@Icons.Material.Filled.LocationCity"
                                     OnClick="@(() => AlternarModoValidacionAsync("gps"))">
                                🏛️ GPS Campus (@(_radioToleranciaMetros)m)
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(_qrEstaticoUnico ? Variant.Filled : Variant.Outlined)"
                                     Color="@(_qrEstaticoUnico ? Color.Warning : Color.Default)"
                                     Icon="@(_qrEstaticoUnico ? Icons.Material.Filled.Lock : Icons.Material.Filled.Autorenew)"
                                     OnClick="AlternarQREstaticoAsync">
                                @(_qrEstaticoUnico ? "🔒 QR Único" : "🔄 QR Dinámico (15s)")
                            </MudChip>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Tune"
                                     OnClick="@(() => _mostrarAjustesModal = true)">
                                ⏱️ @(_minutosCaducidad) min | ⚙️ Ajustar
                            </MudChip>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Columna Derecha: Métricas y Feed en Vivo -->
            <aside class="metrics-section">
                <!-- Tarjeta Contador Asistentes -->
                <div class="metric-card counter-card">
                    <div class="counter-header">
                        <span class="metric-lbl">ESTUDIANTES EN AULA</span>
                        <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <div class="counter-value">
                        <span class="big-number">@_totalPresentes</span>
                        <span class="counter-badge">Alumnos Registrados</span>
                    </div>
                </div>

                <!-- Tarjeta Temporizador Sesión 20 min -->
                <div class="metric-card timer-card">
                    <div class="counter-header">
                        <span class="metric-lbl">TIEMPO RESTANTE DE ASISTENCIA</span>
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Size="Size.Medium" />
                    </div>
                    <div class="timer-display">
                        <span class="timer-digits">@_tiempoRestanteSesionString</span>
                        <span class="timer-desc">Cierre automático a los 20 min</span>
                    </div>
                    <MudProgressLinear Color="Color.Warning"
                                       Value="@_porcentajeTiempoSesion"
                                       Rounded="true"
                                       Class="my-2"
                                       Size="Size.Medium" />
                </div>

                <!-- Feed en Vivo de Últimos Registros -->
                <div class="metric-card feed-card">
                    <div class="feed-header">
                        <div class="d-flex align-center gap-2">
                            <span class="feed-dot"></span>
                            <span class="metric-lbl">ASISTENCIA EN VIVO</span>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="Reiniciar asistencias de prueba a 0 para volver a escanear">
                                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="ReiniciarAsistenciaParaPruebasAsync" />
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">SignalR Conectado</MudText>
                        </div>
                    </div>

                    <div class="feed-list">
                        @if (_ultimosRegistrados.Count == 0)
                        {
                            <div class="feed-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Large" Class="mb-2 text-muted" />
                                <p>Esperando los primeros escaneos...</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var reg in _ultimosRegistrados)
                            {
                                <div class="feed-item slide-in" style="cursor: pointer;" @ondblclick="@(() => AbrirDetalleGpsEstudiante(reg))" @onclick="@(() => AbrirDetalleGpsEstudiante(reg))">
                                    <div class="feed-item-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </div>
                                    <div class="feed-item-info">
                                        <div class="d-flex justify-space-between align-center">
                                            <span class="feed-item-name">@reg.Nombre</span>
                                            @if (reg.DistanciaMetros.HasValue)
                                            {
                                                <span style="font-size: 0.7rem; font-weight: 700; background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 2px 6px; border-radius: 4px;">
                                                    @reg.DistanciaMetros.Value.ToString("F1")m
                                                </span>
                                            }
                                        </div>
                                        <span class="feed-item-code">@reg.Codigo &bull; @reg.Hora &bull; 🔍 Telemetría</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Acciones del Docente: Revinculación, Suspensión y Cierre -->
                <div class="actions-card d-flex flex-column gap-1">
                    <MudBadge Content="@_solicitudesRevinculacionPendientes"
                              Color="Color.Warning"
                              Overlap="true"
                              Visible="@(_solicitudesRevinculacionPendientes > 0)"
                              Class="w-100">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PhonelinkLock"
                                   OnClick="AbrirDialogoRevinculaciones"
                                   Class="py-1">
                            Revinculación de Dispositivos (@_solicitudesRevinculacionPendientes)
                        </MudButton>
                    </MudBadge>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ReportProblem"
                               OnClick="AbrirDialogoSuspensionEmergencia"
                               Class="py-1">
                        Suspender Clase (Emergencia)
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.LockClock"
                               OnClick="CerrarAsistenciaManualmente"
                               Class="py-1"
                               Style="font-weight: 700;">
                        Cerrar Asistencia Ahora
                    </MudButton>
                </div>
            </aside>
        </main>
    }

    <!-- Modal Flotante de Ajustes de Sesión (Tiempo, Modo y Alcance) -->
    @if (_mostrarAjustesModal)
    {
        <div class="ajustes-modal-backdrop" @onclick="@(() => _mostrarAjustesModal = false)">
            <div class="ajustes-modal-card" @onclick:stopPropagation="true">
                <!-- Header Fijo con botón cerrar -->
                <div class="ajustes-modal-header">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                        <span class="ajustes-modal-title">Ajustes de Sesión y Asistencia</span>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   OnClick="@(() => _mostrarAjustesModal = false)"
                                   Class="ajustes-header-close-btn" />
                </div>

                <!-- Cuerpo con scroll táctil independiente -->
                <div class="ajustes-modal-body">
                    <!-- 1. Modo de Asistencia -->
                    <div class="mb-4">
                        <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                            Modo de Validación Requerido:
                        </label>
                        <div class="d-flex gap-2 flex-wrap">
                            <MudButton Variant="@(_modoValidacion == "proximidad" ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Science"
                                       OnClick="@(() => AlternarModoValidacionAsync("proximidad"))"
                                       Class="flex-grow-1 py-2"
                                       Style="font-weight: 700;">
                                🧪 GPS Experimental
                            </MudButton>
                            <MudButton Variant="@(_modoValidacion == "wifi" ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Wifi"
                                       OnClick="@(() => AlternarModoValidacionAsync("wifi"))"
                                       Class="flex-grow-1 py-2">
                                📶 Solo Wi-Fi / QR
                            </MudButton>
                            <MudButton Variant="@(_modoValidacion == "gps" ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.LocationCity"
                                       OnClick="@(() => AlternarModoValidacionAsync("gps"))"
                                       Class="flex-grow-1 py-2">
                                🏛️ GPS Campus Fijo
                            </MudButton>
                        </div>
                        <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-top: 0.35rem;">
                            @(_modoValidacion == "proximidad" 
                                ? "🧪 GPS Experimental (P2P): Compara la distancia satelital exacta entre el punto fijado por el docente y el celular del estudiante con radio estricto (25m o 50m) y margen máx de +5m."
                                : (_modoValidacion == "wifi" 
                                    ? "📶 Modo Wi-Fi: Valida inmediatamente sin requerir satélites GPS (ideal para pruebas y lugares sin señal)."
                                    : "🏛️ Modo Campus: Valida contra las coordenadas fijas del catálogo institucional del aula."))
                        </span>
                    </div>

                    <!-- 2. Tiempo de Caducidad de la Sesión -->
                    <div class="mb-4">
                        <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                            Tiempo de Caducidad / Ventana de Sesión (Minutos):
                        </label>
                        <MudNumericField T="int" @bind-Value="_minutosCaducidad" Min="1" Max="240" Step="5"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HelperText="Tiempo total que la sesión permanecerá abierta para escaneo (actualiza el temporizador)." />
                    </div>

                    <!-- 3. Comportamiento del Código QR (Dinámico vs QR Único) -->
                    <div class="mb-4">
                        <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                            Rotación del Código QR:
                        </label>
                        <div class="d-flex gap-2">
                            <MudButton Variant="@(!_qrEstaticoUnico ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Autorenew"
                                       OnClick="@(() => _qrEstaticoUnico = false)"
                                       Class="flex-grow-1 py-2">
                                🔄 Dinámico (Rotación 15s)
                            </MudButton>
                            <MudButton Variant="@(_qrEstaticoUnico ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Lock"
                                       OnClick="@(() => _qrEstaticoUnico = true)"
                                       Class="flex-grow-1 py-2">
                                🔒 QR Único (Sin rotación)
                            </MudButton>
                        </div>
                        <span style="font-size: 0.75rem; color: #94a3b8; display: block; margin-top: 0.35rem;">
                            @(!_qrEstaticoUnico 
                                ? "🛡️ Modo anti-fraude: el código QR cambia cada 15 segundos para evitar que compartan capturas de pantalla." 
                                : "📌 QR Fijo: se proyecta un único código QR válido durante toda la clase sin rotar.")
                        </span>
                    </div>

                    <!-- 4. Alcance de Ubicación (Radio de Tolerancia en Metros) -->
                    @if (_modoValidacion == "gps" || _modoValidacion == "proximidad")
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0;">
                                    Alcance de Ubicación GPS (Tolerancia en Metros):
                                </label>
                                <span style="font-size: 0.8rem; color: #38bdf8; font-weight: 700;">@_radioToleranciaMetros m</span>
                            </div>
                            <MudNumericField T="int" @bind-Value="_radioToleranciaMetros" Min="20" Max="100000" Step="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HelperText="Distancia máxima permitida. Para pruebas desde casa o campus extendido, puedes ampliarlo a 10000m o más." />

                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <MudChip T="string" Size="Size.Small" Variant="@(_radioToleranciaMetros == 25 ? Variant.Filled : Variant.Outlined)" Color="Color.Error" OnClick="@(() => _radioToleranciaMetros = 25)" Style="font-weight: 700;">🎯 Aula Estricta (25m)</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="@(_radioToleranciaMetros == 50 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => _radioToleranciaMetros = 50)" Style="font-weight: 700;">🏫 Aula Grande (50m)</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="@(_radioToleranciaMetros == 100 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => _radioToleranciaMetros = 100)">🏢 Pabellón (100m)</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="@(_radioToleranciaMetros == 300 ? Variant.Filled : Variant.Outlined)" Color="Color.Info" OnClick="@(() => _radioToleranciaMetros = 300)">🌳 Campus (300m)</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="@(_radioToleranciaMetros == 10000 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => _radioToleranciaMetros = 10000)">🏠 Modo Pruebas (10 km)</MudChip>
                            </div>

                            <div class="pa-2 mt-2" style="background: rgba(56, 189, 248, 0.08); border-left: 3px solid #38bdf8; border-radius: 4px; font-size: 0.72rem; color: #bae6fd;">
                                💡 <b>Aclaración:</b> El GPS compara la posición satelital del celular contra las <b>coordenadas geográficas del Campus Universitario</b> (no contra la pantalla de la PC). Para probar desde tu casa, pulsa <b>"Fijar Aula con Mi GPS Actual"</b> o <b>"Pruebas Ciudad (10 km)"</b>.
                            </div>

                            <!-- Calibración y Punto A (Coordenadas de Referencia del QR) -->
                            <div class="mt-3 pa-3" style="background: rgba(14, 165, 233, 0.08); border-radius: 12px; border: 1.5px solid rgba(14, 165, 233, 0.35);">
                                <div class="d-flex justify-space-between align-center mb-2 flex-wrap gap-1">
                                    <label style="font-size: 0.85rem; color: #38bdf8; font-weight: 800; display: flex; align-items: center; gap: 4px;">
                                        🎯 Coordenadas del QR (Punto A - Referencia)
                                    </label>
                                    <span style="font-size: 0.72rem; color: #94a3b8;">
                                        (Ej: -17.839221, -63.194188)
                                    </span>
                                </div>

                                <!-- Entrada Unificada de Coordenadas -->
                                <div class="d-flex gap-2 align-center">
                                    <MudTextField @bind-Value="_coordenadasPuntoATexto"
                                                  Placeholder="Pega aquí: -17.839221, -63.194188 o link Maps"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Class="flex-grow-1"
                                                  Style="font-family: monospace; font-size: 0.95rem; font-weight: 700; color: #38bdf8; background: rgba(0,0,0,0.25);" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="ActualizarCoordenadasDesdeTextoAsync"
                                               StartIcon="@Icons.Material.Filled.CheckCircle"
                                               Style="white-space: nowrap; font-weight: 800;">
                                        Fijar
                                    </MudButton>
                                </div>

                                <!-- Indicador Visual Prominente de Coordenada Activa -->
                                <div class="pa-2 mt-2" style="background: rgba(0, 0, 0, 0.4); border-radius: 8px; border: 1px solid rgba(56, 189, 248, 0.2); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                                    <div>
                                        <span style="font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; display: block;">📍 Coordenada Activa en el Código QR:</span>
                                        <span style="font-family: monospace; font-size: 0.95rem; font-weight: 800; color: #34d399;">
                                            @((_latitudPersonalizada ?? _espacio?.Latitud ?? -17.776200).ToString("F6", System.Globalization.CultureInfo.InvariantCulture)), 
                                            @((_longitudPersonalizada ?? _espacio?.Longitud ?? -63.195100).ToString("F6", System.Globalization.CultureInfo.InvariantCulture))
                                        </span>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.MyLocation"
                                                   OnClick="CalibrarUbicacionDocenteAsync"
                                                   Disabled="_calibrandoGps"
                                                   Style="font-size: 0.72rem;">
                                            @(_calibrandoGps ? "Detectando..." : "📍 GPS de esta PC")
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Tertiary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.PhoneAndroid"
                                                   OnClick="AbrirModalCalibracionCelular"
                                                   Style="font-size: 0.72rem;">
                                            📱 Celular Docente
                                        </MudButton>
                                    </div>
                                </div>

                                @if (_calibracionMargenErrorPc > 100 && _radioToleranciaMetros <= 100)
                                {
                                    <div class="pa-2 mt-2" style="background: rgba(239, 68, 68, 0.15); border-left: 3px solid #ef4444; border-radius: 4px; font-size: 0.72rem; color: #fca5a5;">
                                        ⚠️ <b>Aviso:</b> El GPS de esta PC fue estimado por Wi-Fi/IP (margen de ~@(_calibracionMargenErrorPc.ToString("F0"))m). Si estás en tu casa o recinto, pega tus coordenadas de Google Maps arriba para un cálculo satelital exacto.
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_calibracionMensaje))
                                {
                                    <div style="font-size: 0.72rem; color: #34d399; margin-top: 0.35rem;">
                                        @_calibracionMensaje
                                    </div>
                                }

                                <!-- Sedes y Recintos Frecuentes (1 Clic) -->
                                <div class="mt-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 600;">
                                            Sedes Rápidas (1 Clic):
                                        </span>
                                        <a href="https://maps.google.com" target="_blank" style="font-size: 0.72rem; color: #38bdf8; text-decoration: underline;">
                                            🌐 Abrir Google Maps
                                        </a>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => FijarCoordenadasDirectas(-17.776200, -63.195100, "UPDS Central"))">🎓 UPDS Central</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => FijarCoordenadasDirectas(-17.776500, -63.191500, "UAGRM Campus"))">🏛️ UAGRM Campus</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => FijarCoordenadasDirectas(-17.788400, -63.181200, "San Juan de Dios"))">🏥 Hosp. San Juan</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => FijarCoordenadasDirectas(-17.768100, -63.153900, "Hosp. Japonés"))">🏥 Hosp. Japonés</MudChip>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 5. Dominio / Servidor Base para el QR -->
                    <div class="mb-4">
                        <label style="font-size: 0.8125rem; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 0.5rem;">
                            Dominio / Servidor Base para el QR (Opcional):
                        </label>
                        <MudTextField @bind-Value="_servidorBasePersonalizado"
                                      Placeholder="@(Navigation.BaseUri.TrimEnd('/'))"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="Si se deja vacío, el QR usa automáticamente el dominio actual (en MonsterASP.NET usa el dominio público)." />
                    </div>
                </div>

                <!-- Footer Fijo con botones Guardar y Cancelar -->
                <div class="ajustes-modal-footer">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Medium"
                               OnClick="@(() => _mostrarAjustesModal = false)">
                        Cerrar
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               OnClick="GuardarAjustesSesionAsync"
                               StartIcon="@Icons.Material.Filled.Save"
                               Style="font-weight: 700;">
                        Guardar y Aplicar
                    </MudButton>
                </div>
            </div>
        </div>
    }

    <!-- Modal para Calibrar Aula con Celular del Docente -->
    @if (_mostrarModalCalibrarCelular)
    {
        <div class="ajustes-modal-backdrop" style="z-index: 100010;">
            <div class="ajustes-modal-card" style="max-width: 440px; text-align: center; padding: 1.5rem;">
                <div class="d-flex justify-space-between align-center mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Color="Color.Info" />
                        <span style="font-weight: 700; font-size: 1.1rem; color: #ffffff;">Calibrar con Celular</span>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="@(() => _mostrarModalCalibrarCelular = false)" />
                </div>

                <p style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 1rem;">
                    Apunta la cámara de tu celular a este código para capturar los satélites GPS reales de la sala (hospital, teatro o aula) con 5m de precisión.
                </p>

                <div style="background: #ffffff; padding: 0.85rem; border-radius: 1rem; display: inline-block; margin-bottom: 1rem;">
                    @((MarkupString)_qrCalibrarCelularSvg)
                </div>

                <div class="d-flex gap-2 justify-center mb-1">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopiarEnlaceCalibrarAsync">
                        Copiar Enlace
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="CerrarModalCalibracionCelularAsync">
                        ✅ Ya Calibré / Listo
                    </MudButton>
                </div>
            </div>
        </div>
    }

    <!-- Modal Telemetría de Estudiante (Doble Clic o Toque en Lista en Vivo) -->
    @if (_estudianteSeleccionadoTelemetria != null)
    {
        <div class="ajustes-modal-backdrop" style="z-index: 100015;" @onclick="@(() => _estudianteSeleccionadoTelemetria = null)">
            <div class="ajustes-modal-card" style="max-width: 480px;" @onclick:stopPropagation="true">
                <div class="ajustes-modal-header">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Primary" />
                        <span class="ajustes-modal-title">Telemetría de Asistencia del Alumno</span>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Medium" OnClick="@(() => _estudianteSeleccionadoTelemetria = null)" Class="ajustes-header-close-btn" />
                </div>
                <div class="ajustes-modal-body">
                    <div class="d-flex align-center gap-3 mb-3">
                        <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(99, 102, 241, 0.2); display: flex; align-items: center; justify-content: center; color: #818cf8; font-weight: 800; font-size: 1.25rem;">
                            @(_estudianteSeleccionadoTelemetria.Nombre.Length > 0 ? _estudianteSeleccionadoTelemetria.Nombre[0].ToString() : "E")
                        </div>
                        <div>
                            <h4 style="margin: 0; color: #f8fafc; font-size: 1.1rem; font-weight: 700;">@_estudianteSeleccionadoTelemetria.Nombre</h4>
                            <span style="color: #94a3b8; font-size: 0.85rem;">Código: @_estudianteSeleccionadoTelemetria.Codigo &bull; Hora: @_estudianteSeleccionadoTelemetria.Hora</span>
                        </div>
                    </div>

                    <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 0.75rem; padding: 1rem; margin-bottom: 1rem; font-size: 0.875rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="color: #94a3b8;">Modo de Validación:</span>
                            <span style="color: #38bdf8; font-weight: 600;">@_estudianteSeleccionadoTelemetria.Modo.ToUpperInvariant()</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="color: #94a3b8;">📍 Coordenadas Celular:</span>
                            <span style="color: #f8fafc; font-weight: 600; font-family: monospace;">
                                @(_estudianteSeleccionadoTelemetria.Latitud.HasValue && _estudianteSeleccionadoTelemetria.Longitud.HasValue 
                                    ? $"{_estudianteSeleccionadoTelemetria.Latitud.Value:F6}, {_estudianteSeleccionadoTelemetria.Longitud.Value:F6}" 
                                    : "N/D (Wi-Fi)")
                            </span>
                        </div>
                        @if (_estudianteSeleccionadoTelemetria.PrecisionMetros.HasValue)
                        {
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="color: #94a3b8;">📡 Precisión Satelital (Margen):</span>
                                <span style="color: #f8fafc; font-weight: 600;">±@(_estudianteSeleccionadoTelemetria.PrecisionMetros.Value.ToString("F1")) metros</span>
                            </div>
                        }
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="color: #94a3b8;">🎯 Punto Referencia QR:</span>
                            <span style="color: #f8fafc; font-weight: 600; font-family: monospace;">
                                @(_estudianteSeleccionadoTelemetria.QrLatitud.HasValue && _estudianteSeleccionadoTelemetria.QrLongitud.HasValue 
                                    ? $"{_estudianteSeleccionadoTelemetria.QrLatitud.Value:F6}, {_estudianteSeleccionadoTelemetria.QrLongitud.Value:F6}" 
                                    : (_latitudPersonalizada?.ToString("F6") ?? _espacio?.Latitud?.ToString("F6") ?? "N/D"))
                            </span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="color: #94a3b8;">📏 Distancia Calculada:</span>
                            <span style="color: #34d399; font-weight: 800; font-size: 1rem;">
                                @(_estudianteSeleccionadoTelemetria.DistanciaMetros.HasValue 
                                    ? $"{_estudianteSeleccionadoTelemetria.DistanciaMetros.Value:F1} metros" 
                                    : "Verificado por Red")
                            </span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #94a3b8;">🎯 Radio Máx Permitido:</span>
                            <span style="color: #f8fafc; font-weight: 600;">@(_radioToleranciaMetros)m (+5m ruido satelital)</span>
                        </div>
                    </div>

                    @if (_estudianteSeleccionadoTelemetria.Latitud.HasValue && _estudianteSeleccionadoTelemetria.Longitud.HasValue)
                    {
                        <a href="https://www.google.com/maps?q=@(_estudianteSeleccionadoTelemetria.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(_estudianteSeleccionadoTelemetria.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-size-medium w-100 py-2 d-flex align-center justify-center gap-2" 
                           style="text-decoration: none; font-weight: 700; border-radius: 0.75rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                            Ver Ubicación del Alumno en Google Maps
                        </a>
                    }
                </div>
                <div class="ajustes-modal-footer">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => _estudianteSeleccionadoTelemetria = null)">
                        Cerrar
                    </MudButton>
                </div>
            </div>
        </div>
    }

    <!-- Modal Pantalla Completa QR para Proyección en Aula -->
    @if (_qrPantallaCompleta)
    {
        <div class="qr-fullscreen-modal">
            <!-- Botón flotante circular X siempre accesible en móviles y PC -->
            <button type="button" class="qr-floating-close-btn" @onclick="CerrarQRPantallaCompleta" aria-label="Cerrar proyección" title="Cerrar pantalla completa">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Medium" />
            </button>

            <!-- Barra Superior Adaptable -->
            <div class="qr-fullscreen-topbar">
                <div class="qr-fs-info-group">
                    <h2 class="qr-fs-title">@_materia?.Nombre</h2>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <span class="qr-fs-badge">@_materia?.Codigo &bull; Gr. @_materia?.Grupo</span>
                        <div class="status-pulse">
                            <span class="pulse-dot"></span>
                            <span class="status-text">ESCANEO ACTIVO</span>
                        </div>
                    </div>
                </div>

                <div class="qr-fs-status-group">
                    <div class="qr-fs-stat-item">
                        <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Small" Class="mr-1 text-primary" />
                        <span><b>@_totalPresentes</b> presentes</span>
                    </div>

                    @if (!_qrEstaticoUnico)
                    {
                        <div class="qr-fs-stat-item timer-active">
                            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="mr-1 spin-icon" />
                            <span>Rotación en <b>@_segundosRestantesRotacion s</b></span>
                        </div>
                    }
                    else
                    {
                        <div class="qr-fs-stat-item timer-fixed">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                            <span>QR Único Fijo</span>
                        </div>
                    }

                    <MudButton Variant="@(_qrEstaticoUnico ? Variant.Filled : Variant.Outlined)"
                               Color="@(_qrEstaticoUnico ? Color.Warning : Color.Info)"
                               StartIcon="@(_qrEstaticoUnico ? Icons.Material.Filled.Lock : Icons.Material.Filled.Autorenew)"
                               Size="Size.Small"
                               OnClick="AlternarQREstaticoAsync"
                               Class="qr-fs-toggle-btn"
                               Style="font-weight: 700; border-radius: 8px;">
                        @(_qrEstaticoUnico ? "🔒 QR Fijo" : "🔄 QR Dinámico")
                    </MudButton>
                </div>
            </div>

            <!-- Centro con el Código QR -->
            <div class="qr-fullscreen-center">
                <div class="qr-fullscreen-whitebox">
                    @if (!string.IsNullOrEmpty(_qrSvgContent))
                    {
                        <div class="qr-fullscreen-svg-wrap">
                            @((MarkupString)_qrSvgContent)
                        </div>
                    }
                    else
                    {
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    }
                </div>

                <div class="rotation-progress-bar mt-3">
                    <div class="progress-fill" style="width: @(_porcentajeRotacion)%; background: @(_qrEstaticoUnico ? "linear-gradient(90deg, #f59e0b, #10b981)" : "linear-gradient(90deg, #4f46e5, #06b6d4)");"></div>
                </div>

                <p class="qr-fullscreen-hint">
                    Apunta con la cámara de tu teléfono móvil registrado hacia la pantalla para registrar tu asistencia.
                </p>
            </div>
        </div>
    }
</div>

<style>
    .proyeccion-container {
        height: 100vh;
        max-height: 100vh;
        overflow: hidden;
        background: radial-gradient(circle at 50% 10%, #1e1b4b 0%, #090d16 80%);
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        padding: 0.75rem 1.5rem;
        box-sizing: border-box;
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    .proyeccion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 0.5rem;
        margin-bottom: 0.6rem;
        flex-shrink: 0;
    }

    .brand-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        padding: 0.2rem 0.65rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .materia-title {
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.15rem;
