    private async Task InicializarSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/attendance"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<string, string, int>("AsistenciaRegistrada", (estudianteNombre, estudianteCodigo, totalPresentes) =>
            {
                InvokeAsync(() =>
                {
                    _totalPresentes = totalPresentes;
                    _ultimosRegistrados.RemoveAll(x => x.Codigo == estudianteCodigo);
                    _ultimosRegistrados.Insert(0, (estudianteNombre, estudianteCodigo, DateTime.Now.ToString("HH:mm:ss")));
                    if (_ultimosRegistrados.Count > 10)
                    {
                        _ultimosRegistrados.RemoveAt(_ultimosRegistrados.Count - 1);
                    }
                    StateHasChanged();
                });
            });

            _hubConnection.On<string>("SesionCerrada", (sesionIdStr) =>
            {
                if (_sesion != null && sesionIdStr == _sesion.Id.ToString())
                {
                    InvokeAsync(() =>
                    {
                        _sesionCerrada = true;
                        StateHasChanged();
                    });
                }
            });

            _hubConnection.On<string, string, string, string>("NuevaSolicitudRevinculacion", (solId, estNombre, estCodigo, hora) =>
            {
                InvokeAsync(() =>
                {
                    _solicitudesRevinculacionPendientes++;
