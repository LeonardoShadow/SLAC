            : (nuevoModo == "proximidad"
                ? $"Modo cambiado a '🧪 GPS Experimental': validación P2P contra el docente ({_radioToleranciaMetros}m + 5m margen satelital)."
                : $"Modo cambiado a 'GPS Campus Fijo': validación institucional dentro de {_radioToleranciaMetros}m."),
            Severity.Info);
    }

    private async Task ActualizarCoordenadasDesdeTextoAsync()
    {
        if (string.IsNullOrWhiteSpace(_coordenadasPuntoATexto))
        {
            Snackbar.Add("Ingresa las coordenadas en formato: -17.839221, -63.194188", Severity.Warning);
            return;
        }

        var input = _coordenadasPuntoATexto.Trim();
        var match = System.Text.RegularExpressions.Regex.Match(input, @"(-?\d{1,2}[\.,]\d+)[,\s;]+(-?\d{1,3}[\.,]\d+)");
        if (match.Success)
        {
            var latStr = match.Groups[1].Value.Replace(',', '.');
            var lonStr = match.Groups[2].Value.Replace(',', '.');

            if (double.TryParse(latStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lat) &&
                double.TryParse(lonStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lon))
            {
                await FijarCoordenadasDirectas(lat, lon, "Punto A Fijado");
                return;
            }
        }

        Snackbar.Add("No se reconocieron coordenadas válidas. Formato: -17.839221, -63.194188 o enlace de Google Maps.", Severity.Warning);
    }

    private async Task FijarCoordenadasDirectas(double lat, double lon, string lugarNombre)
    {
        _latitudPersonalizada = lat;
        _longitudPersonalizada = lon;
        _coordenadasPuntoATexto = $"{lat.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}, {lon.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";
        _calibracionMargenErrorPc = 0; // Coordenada satelital exacta fijada por el usuario
        _calibracionMensaje = $"✅ Ubicación fijada ({lugarNombre}): {lat.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}, {lon.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";

        if (_espacio != null)
        {
            _espacio.Latitud = lat;
            _espacio.Longitud = lon;
            await EspacioRepo.UpdateAsync(_espacio);
        }

        await RotarCodigoQrAsync();
        Snackbar.Add($"Punto A fijado: {lugarNombre} ({lat:F6}, {lon:F6})", Severity.Success);
        StateHasChanged();
    }

