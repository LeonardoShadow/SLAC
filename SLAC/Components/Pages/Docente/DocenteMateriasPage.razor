@page "/docente/materias"
@rendermode InteractiveServer
@using SLAC.Core.Estudiantes.Repositories
@using SLAC.Core.Estudiantes.Entities
@using SLAC.Core.Attendance.Repositories
@using SLAC.Core.Attendance.Entities
@using SLAC.Features.Attendance.Services
@inject IMateriaRepository MateriaRepo
@inject IDocenteRepository DocenteRepo
@inject IPeriodoAcademicoRepository PeriodoRepo
@inject IEspacioRepository EspacioRepo
@inject IEstudianteRepository EstudianteRepo
@inject ISuscripcionRepository SuscripcionRepo
@inject IUserSessionService SessionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>SLAC - Mis Materias (Docente)</PageTitle>

<div class="pa-4 pa-md-6">
    <!-- Header & Hero Section -->
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6 gap-4">
        <div>
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Mis Materias Asignadas</MudText>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gestión de asignaturas, configuración de horarios fijos y proyección de listas de asistencia.
            </MudText>
        </div>

        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AbrirDialogoNuevaMateria"
                       Size="Size.Medium">
                Nueva Materia
            </MudButton>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2" Class="rounded-lg pa-3" Style="border-left: 5px solid var(--mud-palette-primary);">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL MATERIAS ACTIVAS</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_materias.Count(m => m.Estado == "activa")</MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2" Class="rounded-lg pa-3" Style="border-left: 5px solid var(--mud-palette-success);">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">CLASES PARA HOY (@_diaHoyNombre)</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_materiasHoy.Count</MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Small" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2" Class="rounded-lg pa-3" Style="border-left: 5px solid var(--mud-palette-info);">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">MATERIAS ARCHIVADAS</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_materias.Count(m => m.Estado == "archivada")</MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_loading)
    {
        <div class="d-flex justify-center align-center pa-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_materias.Count == 0)
    {
        <MudCard Elevation="1" Class="pa-10 text-center rounded-lg">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h6">No hay materias registradas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Comienza agregando tu primera materia con aula, días de clase (L-V) y horario de inicio.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirDialogoNuevaMateria">
                Registrar Primera Materia
            </MudButton>
        </MudCard>
    }
    else
    {
        <!-- Pestañas de Filtro: Activas vs Archivadas -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_filtroEstadoIndex" Class="mb-4">
            <MudTabPanel Text="@($"Materias Activas ({_materias.Count(m => m.Estado == "activa")})")" Icon="@Icons.Material.Filled.CheckCircle" />
            <MudTabPanel Text="@($"Materias Archivadas ({_materias.Count(m => m.Estado == "archivada")})")" Icon="@Icons.Material.Filled.Archive" />
            <MudTabPanel Text="@($"Todas ({_materias.Count})")" Icon="@Icons.Material.Filled.List" />
        </MudTabs>

        @if (!MateriasFiltradas.Any())
        {
            <MudCard Elevation="0" Class="pa-8 text-center rounded-lg" Style="border: 1px dashed var(--mud-palette-lines-default); background: transparent;">
                <MudIcon Icon="@(_filtroEstadoIndex == 1 ? Icons.Material.Filled.Archive : Icons.Material.Filled.FolderOpen)" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                <MudText Typo="Typo.h6">@(_filtroEstadoIndex == 1 ? "No hay materias archivadas" : "No hay materias activas en esta sección")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(_filtroEstadoIndex == 1 ? "Las materias que archives se guardarán aquí para no estorbar en tu lista principal." : "Puedes registrar una nueva materia o restaurar alguna archivada.")
                </MudText>
            </MudCard>
        }
        else
        {
            <!-- Courses Cards Grid -->
            <MudGrid>
                @foreach (var materia in MateriasFiltradas)
                {
                    var esArchivada = materia.Estado == "archivada";
                    var tieneClaseHoy = !esArchivada && _materiasHoy.Any(m => m.Id == materia.Id);
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Elevation="@(esArchivada ? 1 : 3)" Class="rounded-xl h-100 d-flex flex-column" Style="@($"overflow: hidden; border: 1px solid var(--mud-palette-lines-default); {(esArchivada ? "opacity: 0.85; background: rgba(0,0,0,0.02);" : "")}")">
                            <!-- Accent Top Bar -->
                            <div style="height: 6px; background: @(esArchivada ? "var(--mud-palette-text-disabled)" : tieneClaseHoy ? "var(--mud-palette-success)" : "var(--mud-palette-primary)");"></div>

                            <MudCardContent Class="flex-grow-1 pa-5">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <div class="d-flex gap-1 align-center">
                                        <MudChip T="string" Size="Size.Small" Color="@(esArchivada ? Color.Default : Color.Primary)" Variant="Variant.Filled" Style="font-weight: 700;">
                                            @materia.Codigo
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            Grupo @materia.Grupo
                                        </MudChip>
                                    </div>
                                    @if (esArchivada)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Archive">
                                            Archivada
                                        </MudChip>
                                    }
                                    else if (tieneClaseHoy)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                                            Hoy
                                        </MudChip>
                                    }
                                </div>

                                <MudText Typo="Typo.h6" Style="font-weight: 600; line-height: 1.3;" Class="mb-3">
                                    @materia.Nombre
                                </MudText>

                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        <b>Aula:</b> @(ObtenerNombreEspacio(materia.EspacioId))
                                    </MudText>
                                </div>

                                <div class="d-flex align-center gap-2 mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        <b>Hora:</b> @materia.HoraInicio.ToString(@"hh\:mm") hrs (90 min)
                                    </MudText>
                                </div>

                                <!-- Días de clase -->
                                <div class="mt-2 mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                                        DÍAS DE CLASE:
                                    </MudText>
                                    <div class="d-flex gap-1">
                                        @foreach (var sigla in new[] { "L", "M", "X", "J", "V" })
                                        {
                                            var activo = materia.ObtenerListaDias().Contains(sigla);
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@(activo ? (esArchivada ? Color.Default : Color.Primary) : Color.Default)"
                                                     Variant="@(activo ? Variant.Filled : Variant.Text)"
                                                     Style="@(activo ? "font-weight: 700;" : "opacity: 0.4;")">
                                                @sigla
                                            </MudChip>
                                        }
                                    </div>
                                </div>
                            </MudCardContent>

                            <MudCardActions Class="pa-4 pt-0 d-flex justify-space-between align-center flex-wrap gap-2">
                                <div class="d-flex gap-2">
                                    @if (!esArchivada)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.QrCode2"
                                                   OnClick="@(() => IniciarProyeccion(materia.Id))">
                                            Proyectar QR
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Group"
                                               OnClick="@(() => AbrirGestionEstudiantes(materia))">
                                        Estudiantes
                                    </MudButton>
                                </div>

                                <div class="d-flex gap-1">
                                    <MudTooltip Text="Editar Materia">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@(() => AbrirDialogoEditarMateria(materia))" />
                                    </MudTooltip>
                                    @if (esArchivada)
                                    {
                                        <MudTooltip Text="Restaurar / Desarchivar">
                                            <MudIconButton Icon="@Icons.Material.Filled.Unarchive"
                                                           Size="Size.Small"
                                                           Color="Color.Success"
                                                           OnClick="@(() => RestaurarMateriaAsync(materia))" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Archivar Materia">
                                            <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                                           Size="Size.Small"
                                                           Color="Color.Warning"
                                                           OnClick="@(() => ConfirmarArchivar(materia))" />
                                        </MudTooltip>
                                    }
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</div>

@code {
    private bool _loading = true;
    private int _filtroEstadoIndex = 0; // 0: Activas, 1: Archivadas, 2: Todas
    private List<Materia> _materias = [];
    private List<Materia> _materiasHoy = [];

    private IEnumerable<Materia> MateriasFiltradas => _filtroEstadoIndex switch
    {
        0 => _materias.Where(m => m.Estado == "activa"),
        1 => _materias.Where(m => m.Estado == "archivada"),
        _ => _materias
    };
    private List<PeriodoAcademico> _periodos = [];
    private List<Espacio> _espacios = [];
    private PeriodoAcademico? _periodoVigente;
    private Docente? _docenteActual;
    private string _diaHoySigla = "L";
    private string _diaHoyNombre = "Lunes";

    // Institución activa obtenida de la sesión
    private Guid _institucionId => SessionService.UsuarioActual?.InstitucionId ?? Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.EstaAutenticado || (SessionService.RolActual != RolUsuario.Docente && SessionService.RolActual != RolUsuario.Administrador))
        {
            Navigation.NavigateTo("/login?rol=docente");
            return;
        }

        CalcularDiaHoy();
        await CargarDatosAsync();
    }

    private void CalcularDiaHoy()
    {
        var dayOfWeek = TimeHelper.Now.DayOfWeek;
        (_diaHoySigla, _diaHoyNombre) = dayOfWeek switch
        {
            DayOfWeek.Monday => ("L", "Lunes"),
            DayOfWeek.Tuesday => ("M", "Martes"),
            DayOfWeek.Wednesday => ("X", "Miércoles"),
            DayOfWeek.Thursday => ("J", "Jueves"),
            DayOfWeek.Friday => ("V", "Viernes"),
            DayOfWeek.Saturday => ("S", "Sábado"),
            DayOfWeek.Sunday => ("D", "Domingo"),
            _ => ("L", "Lunes")
        };
    }

    private async Task CargarDatosAsync()
    {
        _loading = true;
        try
        {
            // 1. Cargar periodos y espacios
            var periodosTask = PeriodoRepo.GetByInstitucionAsync(_institucionId);
            var espaciosTask = EspacioRepo.GetByInstitucionAsync(_institucionId);
            await Task.WhenAll(periodosTask, espaciosTask);

            _periodos = await periodosTask;
            _espacios = await espaciosTask;

            if (_periodos.Count == 0)
            {
                // Crear periodo por defecto si no existe
                var nuevoPeriodo = new PeriodoAcademico
                {
                    InstitucionId = _institucionId,
                    Nombre = "Gestión I-2026",
                    FechaInicio = new DateOnly(2026, 2, 1),
                    FechaFin = new DateOnly(2026, 6, 30)
                };
                await PeriodoRepo.CreateAsync(nuevoPeriodo);
                _periodos = [nuevoPeriodo];
            }

            var hoy = TimeHelper.Today;
            _periodoVigente = _periodos.FirstOrDefault(p => p.FechaInicio <= hoy && hoy <= p.FechaFin) ?? _periodos.FirstOrDefault();

            if (_espacios.Count == 0)
            {
                // Crear aulas demo si no existen
                var aula1 = new Espacio { InstitucionId = _institucionId, Nombre = "Aula Magna 101", Tipo = "aula", Capacidad = 40 };
                var aula2 = new Espacio { InstitucionId = _institucionId, Nombre = "Lab Computación 2", Tipo = "laboratorio", Capacidad = 25 };
                await EspacioRepo.CreateAsync(aula1);
                await EspacioRepo.CreateAsync(aula2);
                _espacios = [aula1, aula2];
            }

            // 2. Cargar docente actual
            var docentes = await DocenteRepo.ListarPorInstitucionAsync(_institucionId);
            _docenteActual = docentes.FirstOrDefault();
            if (_docenteActual == null && _institucionId == Guid.Parse("11111111-1111-1111-1111-111111111111"))
            {
                _docenteActual = new Docente
                {
                    InstitucionId = _institucionId,
                    UserId = Guid.Parse("55555555-5555-5555-5555-555555555555"),
                    Nombres = "Jimmy",
                    Apellidos = "Requena",
                    Correo = "sc.jimmy.requena.l@upds.edu.bo",
                    Codigo = "87438"
                };
                await DocenteRepo.GuardarAsync(_docenteActual);
            }

            if (SessionService.UsuarioActual?.DocenteId.HasValue == true)
            {
                var docSesion = await DocenteRepo.ObtenerPorIdAsync(SessionService.UsuarioActual.DocenteId.Value);
                if (docSesion != null) _docenteActual = docSesion;
            }

            // 3. Cargar materias del docente
            if (_docenteActual != null)
            {
                var materias = await MateriaRepo.ListarPorDocenteAsync(_docenteActual.Id);
                _materias = materias.OrderBy(m => m.HoraInicio).ToList();

                // 4. Filtrar materias de hoy
                _materiasHoy = _materias
                    .Where(m => m.Estado == "activa" && m.ObtenerListaDias().Contains(_diaHoySigla))
                    .ToList();
            }
            else
            {
                _materias = [];
                _materiasHoy = [];
            }

            // 5. Pre-cargar estudiante de prueba solo para UPDS
            if (_institucionId == Guid.Parse("11111111-1111-1111-1111-111111111111"))
            {
                var estLeo = await EstudianteRepo.ObtenerPorCodigoAsync(_institucionId, "8127564");
                if (estLeo == null)
                {
                    estLeo = new Estudiante
                    {
                        InstitucionId = _institucionId,
                        Codigo = "8127564",
                        Nombres = "Leonardo David",
                        Apellidos = "Vargas Monasterio",
                        Correo = "sc.leonardo.vargas.m@upds.net.bo",
                        DocumentoIdentidad = "8127564",
                        ConsentimientoEn = DateTimeOffset.UtcNow
                    };
                    estLeo = await EstudianteRepo.CrearOActualizarAsync(estLeo);
                }

                // Inscribir en las materias activas para que esté listo en el padrón
                foreach (var mat in _materias)
                {
                    var sub = await SuscripcionRepo.ObtenerAsync(mat.Id, estLeo.Id);
                    if (sub == null)
                    {
                        await SuscripcionRepo.SuscribirAsync(new Suscripcion
                        {
                            InstitucionId = _institucionId,
                            MateriaId = mat.Id,
                            EstudianteId = estLeo.Id,
                            Fecha = DateTimeOffset.UtcNow,
                            Estado = "activa"
                        });
                    }
                }

                // 6. Purgar registros obsoletos o no deseados (ej. 'Ana María García López')
                var todosEstudiantes = await EstudianteRepo.ListarPorInstitucionAsync(_institucionId);
                foreach (var estObsoleto in todosEstudiantes.Where(e =>
                    e.Codigo == "100234" ||
                    e.Codigo == "7654321" ||
                    (e.Correo != null && e.Correo.Contains("ana.garcia", StringComparison.OrdinalIgnoreCase)) ||
                    (e.Nombres != null && e.Nombres.Contains("Ana María", StringComparison.OrdinalIgnoreCase))))
                {
                    foreach (var mat in _materias)
                    {
                        await SuscripcionRepo.DesinscribirAsync(mat.Id, estObsoleto.Id);
                    }
                    await EstudianteRepo.EliminarAsync(estObsoleto.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar materias: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string ObtenerNombreEspacio(Guid espacioId)
    {
        var espacio = _espacios.FirstOrDefault(e => e.Id == espacioId);
        return espacio != null ? $"{espacio.Nombre} ({espacio.Tipo})" : "Aula no asignada";
    }

    private async Task AbrirDialogoNuevaMateria()
    {
        if (_periodoVigente == null || _docenteActual == null || _espacios.Count == 0)
        {
            Snackbar.Add("No hay aulas o periodos disponibles para registrar materias.", Severity.Warning);
            return;
        }

        var nuevaMateria = new Materia
        {
            InstitucionId = _institucionId,
            DocenteId = _docenteActual.Id,
            PeriodoId = _periodoVigente.Id,
            EspacioId = _espacios.First().Id,
            HoraInicio = new TimeSpan(8, 0, 0),
            Dias = "L,M,V"
        };

        var parameters = new DialogParameters<MateriaDialog>
        {
            { x => x.Materia, nuevaMateria },
            { x => x.Periodos, _periodos },
            { x => x.Espacios, _espacios },
            { x => x.EsAdmin, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MateriaDialog>("Crear Asignatura", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is Materia materiaGuardada)
        {
            await MateriaRepo.GuardarAsync(materiaGuardada);
            Snackbar.Add("Materia creada exitosamente.", Severity.Success);
            await CargarDatosAsync();
        }
    }

    private async Task AbrirDialogoEditarMateria(Materia materia)
    {
        var clone = new Materia
        {
            Id = materia.Id,
            InstitucionId = materia.InstitucionId,
            DocenteId = materia.DocenteId,
            PeriodoId = materia.PeriodoId,
            Codigo = materia.Codigo,
            Nombre = materia.Nombre,
            Grupo = materia.Grupo,
            EspacioId = materia.EspacioId,
            HoraInicio = materia.HoraInicio,
            Dias = materia.Dias,
            Estado = materia.Estado,
            CreadoEn = materia.CreadoEn
        };

        var parameters = new DialogParameters<MateriaDialog>
        {
            { x => x.Materia, clone },
            { x => x.Periodos, _periodos },
            { x => x.Espacios, _espacios },
            { x => x.EsAdmin, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MateriaDialog>("Editar Asignatura", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is Materia materiaActualizada)
        {
            await MateriaRepo.GuardarAsync(materiaActualizada);
            Snackbar.Add("Materia actualizada exitosamente.", Severity.Success);
            await CargarDatosAsync();
        }
    }

    private async Task ConfirmarArchivar(Materia materia)
    {
        var confirmacion = await DialogService.ShowMessageBoxAsync(
            "Archivar Asignatura",
            $"¿Estás seguro de que deseas archivar la materia '{materia.Nombre}' ({materia.Codigo})?",
            yesText: "Sí, Archivar",
            cancelText: "Cancelar");

        if (confirmacion == true)
        {
            await MateriaRepo.ArchivarAsync(materia.Id);
            Snackbar.Add("Materia archivada correctamente.", Severity.Info);
            await CargarDatosAsync();
        }
    }

    private async Task RestaurarMateriaAsync(Materia materia)
    {
        materia.Estado = "activa";
        await MateriaRepo.GuardarAsync(materia);
        Snackbar.Add($"Materia '{materia.Nombre}' reactivada exitosamente.", Severity.Success);
        await CargarDatosAsync();
    }

    private void IniciarProyeccion(Guid materiaId)
    {
        Navigation.NavigateTo($"/proyeccion/{materiaId}?reabrir=true");
    }

    private async Task AbrirGestionEstudiantes(Materia materia)
    {
        var parameters = new DialogParameters<GestionEstudiantesDialog>
        {
            { x => x.Materia, materia }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GestionEstudiantesDialog>($"Padrón de Estudiantes - {materia.Nombre}", parameters, options);
        await dialog.Result;
    }
}
