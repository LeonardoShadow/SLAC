@page "/"
@rendermode InteractiveServer
@using SLAC.Features.Attendance.Services
@inject IUserSessionService SessionService

<PageTitle>Portal SLAC - Sistema de Asistencia a Clases</PageTitle>

<div class="mb-6 d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Primary">
            SLAC &bull; Portales del Sistema
        </MudText>
        <MudText Typo="Typo.body1" Class="text-muted">
            Gestión institucional de asistencia con códigos QR seguros tokenizados (ES256) y reporte exclusivo de faltas.
        </MudText>
    </div>

    @if (!SessionService.EstaAutenticado)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Login"
                   Href="/login">
            Iniciar Sesión / Elegir Perfil
        </MudButton>
    }
</div>

<!-- Tarjetas de los 3 Perfiles del Sistema -->
<MudGrid Class="mb-6">
    <!-- PERFIL 1: DOCENTE -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="4" Class="h-100 rounded-lg d-flex flex-column" Style="border-top: 5px solid var(--mud-palette-primary);">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Portal Docente</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Gestión de Clases en Sala</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2" Class="mb-3">
                    Proyecta el código QR dinámico de asistencia en el aula, administra el padrón de alumnos de tu asignatura y genera los reportes oficiales de inasistencias.
                </MudText>
                <div class="d-flex flex-column gap-1">
                    <MudText Typo="Typo.caption" Color="Color.Primary">• Proyección QR y rotación cada 15s</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary">• Carga y edición de estudiantes</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary">• Reporte y justificación de faltas</MudText>
                </div>
            </MudCardContent>
            <MudCardActions Class="pa-3">
                <MudButton Href="@(SessionService.RolActual == RolUsuario.Docente || SessionService.RolActual == RolUsuario.Administrador ? "/docente/materias" : "/login?rol=docente")"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Entrar a Mis Materias
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- PERFIL 2: ESTUDIANTE -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="4" Class="h-100 rounded-lg d-flex flex-column" Style="border-top: 5px solid var(--mud-palette-info);">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.School" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Portal Estudiante</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Consulta Personal del Alumno</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2" Class="mb-3">
                    Consulta las materias en las que estás inscrito, revisa tu historial personal de faltas y asistencias, y visualiza la lista de compañeros de tu clase.
                </MudText>
                <div class="d-flex flex-column gap-1">
                    <MudText Typo="Typo.caption" Color="Color.Info">• Consulta de asignaturas matriculadas</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Info">• Historial de faltas y asistencias</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Info">• Lista de compañeros de clase</MudText>
                </div>
            </MudCardContent>
            <MudCardActions Class="pa-3">
                <MudButton Href="@(SessionService.RolActual == RolUsuario.Estudiante || SessionService.RolActual == RolUsuario.Administrador ? "/estudiante/materias" : "/login?rol=estudiante")"
                           Variant="Variant.Filled"
                           Color="Color.Info"
                           FullWidth="true"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Entrar al Portal Estudiante
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- PERFIL 3: ADMINISTRADOR INSTITUCIONAL -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="4" Class="h-100 rounded-lg d-flex flex-column" Style="border-top: 5px solid var(--mud-palette-success);">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Administrador</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Catálogos y Parámetros Globales</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2" Class="mb-3">
                    Gestiona el inventario de aulas físicas y laboratorios, define la vigencia de los semestres académicos y programa los días no lectivos (feriados).
                </MudText>
                <div class="d-flex flex-column gap-1">
                    <MudText Typo="Typo.caption" Color="Color.Success">• Catálogo de Aulas y Laboratorios</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Success">• Periodos Académicos Semestrales</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Success">• Feriados y Días No Lectivos</MudText>
                </div>
            </MudCardContent>
            <MudCardActions Class="pa-3">
                <MudButton Href="@(SessionService.RolActual == RolUsuario.Administrador ? "/admin/espacios" : "/login?rol=admin")"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Panel Administrador
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Métricas de Arquitectura SLAC -->
<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-3 rounded-lg">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.caption" Class="text-muted">Ventana Asistencia</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Configurable</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined"><MudIcon Icon="@Icons.Material.Filled.Timer" /></MudAvatar>
            </div>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-3 rounded-lg">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.caption" Class="text-muted">Rotación QR</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Secondary">15 seg</MudText>
                </div>
                <MudAvatar Color="Color.Secondary" Variant="Variant.Outlined"><MudIcon Icon="@Icons.Material.Filled.Sync" /></MudAvatar>
            </div>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-3 rounded-lg">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.caption" Class="text-muted">Validación Dual</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">Wi-Fi + GPS</MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Outlined"><MudIcon Icon="@Icons.Material.Filled.ShareLocation" /></MudAvatar>
            </div>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-3 rounded-lg">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <MudText Typo="Typo.caption" Class="text-muted">Criptografía</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Info">ECDSA ES256</MudText>
                </div>
                <MudAvatar Color="Color.Info" Variant="Variant.Outlined"><MudIcon Icon="@Icons.Material.Filled.Security" /></MudAvatar>
            </div>
        </MudCard>
    </MudItem>
</MudGrid>
