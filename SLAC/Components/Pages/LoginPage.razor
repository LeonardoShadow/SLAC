@page "/login"
@rendermode InteractiveServer
@using SLAC.Core.Docentes.Entities
@using SLAC.Core.Docentes.Repositories
@using SLAC.Core.Estudiantes.Entities
@using SLAC.Core.Estudiantes.Repositories
@using SLAC.Features.Attendance.Services

@using SLAC.Core.Institucional.Entities
@using SLAC.Core.Institucional.Repositories
@inject IUserSessionService SessionService
@inject IEstudianteRepository EstudianteRepo
@inject IDocenteRepository DocenteRepo
@inject IInstitucionRepository InstitucionRepo
@inject IAdministradorInstitucionalRepository AdminInstRepo
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>SLAC - Iniciar Sesión</PageTitle>

<div class="login-wrapper">
    <MudCard Elevation="8" Class="login-card pa-6 pa-md-8 rounded-xl">
        <div class="text-center mb-6">
            <div class="d-inline-flex pa-3 rounded-circle mb-3" style="background: rgba(79, 70, 229, 0.1);">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" Color="Color.Primary" />
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -0.5px;" Color="Color.Primary">
                SLAC
            </MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                Sistema de Lista de Asistencia a Clases
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">
                Selecciona tu perfil institucional para ingresar
            </MudText>
        </div>

        <MudTabs @bind-ActivePanelIndex="_tabActiva" Rounded="true" ApplyEffectsToContainer="true" Elevation="1" Color="Color.Primary" Centered="true">
            <!-- PESTAÑA 1: ESTUDIANTE -->
            <MudTabPanel Text="Estudiante" Icon="@Icons.Material.Filled.School">
                <div class="pa-4">
                    <MudText Typo="Typo.body2" Class="mb-3 text-center text-muted">
                        Ingresa con tu Código de Estudiante, CI o Correo Institucional
                    </MudText>

                    <MudTextField @bind-Value="_codigoEstudianteInput"
                                  Immediate="true"
                                  Label="Código de Estudiante, CI o Correo *"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await IngresarComoEstudianteAsync(); })"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Login"
                               OnClick="IngresarComoEstudianteAsync"
                               Disabled="_cargando">
                        @(_cargando ? "Verificando..." : "Ingresar como Estudiante")
                    </MudButton>
                </div>
            </MudTabPanel>

            <!-- PESTAÑA 2: DOCENTE -->
            <MudTabPanel Text="Docente" Icon="@Icons.Material.Filled.Person">
                <div class="pa-4">
                    <MudText Typo="Typo.body2" Class="mb-3 text-center text-muted">
                        Accede con tu Correo Institucional o Código de Docente
                    </MudText>

                    <MudTextField @bind-Value="_docenteInput"
                                  Immediate="true"
                                  Label="Correo Institucional o Código de Docente *"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await IngresarComoDocenteAsync(); })"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Class"
                               OnClick="IngresarComoDocenteAsync"
                               Disabled="_cargando">
                        @(_cargando ? "Verificando..." : "Ingresar como Docente")
                    </MudButton>
                </div>
            </MudTabPanel>

            <!-- PESTAÑA 3: ADMINISTRADOR -->
            <MudTabPanel Text="Administrador" Icon="@Icons.Material.Filled.AdminPanelSettings">
                <div class="pa-4">
                    <MudText Typo="Typo.body2" Class="mb-3 text-center text-muted">
                        Gestión académica institucional (Docentes, Materias, Horarios y Aulas)
                    </MudText>

                    <MudTextField @bind-Value="_correoAdminInput"
                                  Immediate="true"
                                  Label="Correo de Administrador *"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                  @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await IngresarComoAdmin(); })"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="_codigoAdminInput"
                                  Immediate="true"
                                  Label="Código / PIN de Administrador *"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.VpnKey"
                                  @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await IngresarComoAdmin(); })"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.DashboardCustomize"
                               OnClick="IngresarComoAdmin"
                               Disabled="_cargando">
                        Ingresar al Panel Administrador
                    </MudButton>
                </div>
            </MudTabPanel>
        </MudTabs>

        <!-- ACCESO MAESTRO / ADMINISTRADOR GENERAL (DISCRETO Y OCULTO) -->
        <div class="d-flex justify-center align-center pt-3 pb-1" style="border-top: 1px solid rgba(0,0,0,0.06);">
            <MudLink Typo="Typo.caption"
                     Color="Color.Default"
                     Underline="Underline.None"
                     Class="cursor-pointer text-muted"
                     Style="font-size: 0.72rem; opacity: 0.45; letter-spacing: 0.5px;"
                     OnClick="AbrirModalMaestro">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 0.82rem; vertical-align: middle;" Class="mr-1" />
                Acceso Maestro
            </MudLink>
        </div>
    </MudCard>
</div>

<!-- MODAL DE ACCESO MAESTRO (SUPER ADMINISTRADOR MULTITENANT) -->
<MudDialog @bind-Visible="_mostrarModalMaestro" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">
                @(_pasoMaestro == 1 ? "Acceso de Seguridad Central" : "Administrador General del Sistema")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_pasoMaestro == 1)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Introduce la clave maestra de seguridad para desbloquear la consola de administración multitenant.
            </MudText>

            <MudTextField @bind-Value="_claveSeguridadInput"
                          Immediate="true"
                          Label="Clave Maestra de Seguridad *"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.VpnKey"
                          @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") VerificarClaveMaestra(); })"
                          Class="mb-2" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.VerifiedUser">
                Clave validada. Identifícate como Administrador General de la Plataforma.
            </MudAlert>

            <MudTextField @bind-Value="_correoSuperAdminInput"
                          Immediate="true"
                          Label="Correo de Administrador General *"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                          @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") IniciarSesionSuperAdmin(); })"
                          Class="mb-3" />

            <MudTextField @bind-Value="_codigoSuperAdminInput"
                          Immediate="true"
                          Label="Código / PIN de Super Administrador *"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Password"
                          @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") IniciarSesionSuperAdmin(); })"
                          Class="mb-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CerrarModalMaestro" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        @if (_pasoMaestro == 1)
        {
            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="VerificarClaveMaestra">
                Continuar
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Warning" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Shield" OnClick="IniciarSesionSuperAdmin">
                Ingresar al Panel Maestro
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }
    .login-card {
        width: 100%;
        max-width: 520px;
        background: var(--mud-palette-surface);
        border: 1px solid rgba(226, 232, 240, 0.8);
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "rol")]
    public string? RolParam { get; set; }

    private readonly Guid _institucionId = Guid.Parse("11111111-1111-1111-1111-111111111111");
    private bool _cargando = false;
    private int _tabActiva = 0;

    private string _codigoEstudianteInput = string.Empty;
    private string _docenteInput = string.Empty;
    private string _correoAdminInput = string.Empty;
    private string _codigoAdminInput = string.Empty;

    // Control del Acceso Maestro Oculto (Super Admin)
    private bool _mostrarModalMaestro = false;
    private int _pasoMaestro = 1;
    private string _claveSeguridadInput = string.Empty;
    private string _correoSuperAdminInput = string.Empty;
    private string _codigoSuperAdminInput = string.Empty;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true
    };

    protected override void OnParametersSet()
    {
        if (string.Equals(RolParam, "docente", StringComparison.OrdinalIgnoreCase))
        {
            _tabActiva = 1;
        }
        else if (string.Equals(RolParam, "admin", StringComparison.OrdinalIgnoreCase))
        {
            _tabActiva = 2;
        }
        else
        {
            _tabActiva = 0;
        }
    }

    private void AbrirModalMaestro()
    {
        _pasoMaestro = 1;
        _claveSeguridadInput = string.Empty;
        _correoSuperAdminInput = string.Empty;
        _codigoSuperAdminInput = string.Empty;
        _mostrarModalMaestro = true;
    }

    private void CerrarModalMaestro()
    {
        _mostrarModalMaestro = false;
    }

    private void VerificarClaveMaestra()
    {
        var clave = _claveSeguridadInput?.Trim() ?? string.Empty;
        if (clave == "78161193")
        {
            _pasoMaestro = 2;
            Snackbar.Add("Clave maestra aceptada. Ingresa tus credenciales.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Clave maestra de seguridad incorrecta.", Severity.Error);
        }
    }

    private void IniciarSesionSuperAdmin()
    {
        var correo = _correoSuperAdminInput?.Trim() ?? string.Empty;
        var codigo = _codigoSuperAdminInput?.Trim() ?? string.Empty;

        var correoNorm = correo.ToLowerInvariant();
        var userPart = correoNorm.Split('@')[0];

        // Credenciales oficiales de Administrador General:
        // Correo: LeonardoTarea777@gmail.com (insensible a mayúsculas/minúsculas)
        // Código: 75604458
        var esCorreoValido = correoNorm == "leonardotarea777@gmail.com" || userPart == "leonardotarea777";
        var esCodigoValido = codigo == "75604458";

        if (esCorreoValido && esCodigoValido)
        {
            SessionService.IniciarSesionSuperAdmin("Leonardo Vargas (Super Admin)", "LeonardoTarea777@gmail.com");
            Snackbar.Add("Bienvenido, Administrador General. Tienes el control total de la plataforma multitenant.", Severity.Success);
            _mostrarModalMaestro = false;
            Navigation.NavigateTo("/superadmin");
        }
        else
        {
            Snackbar.Add("Credenciales de Administrador General incorrectas.", Severity.Error);
        }
    }

    private async Task IngresarComoEstudianteAsync()
    {
        var input = _codigoEstudianteInput?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(input))
        {
            Snackbar.Add("Por favor ingresa tu código de estudiante, CI o correo institucional.", Severity.Warning);
            return;
        }

        _cargando = true;
        try
        {
            // Validar estado del tenant
            var inst = await InstitucionRepo.ObtenerPorIdAsync(_institucionId);
            if (inst != null && inst.Estado != "activo")
            {
                Snackbar.Add($"El servicio para {inst.Nombre} se encuentra suspendido temporalmente por administración central.", Severity.Error);
                return;
            }

            var todos = (await EstudianteRepo.ListarPorInstitucionAsync(_institucionId)).ToList();
            if (todos.Count == 0)
            {
                var estDemo = new SLAC.Core.Estudiantes.Entities.Estudiante
                {
                    InstitucionId = _institucionId,
                    Codigo = "8127564",
                    Nombres = "Leonardo David",
                    Apellidos = "Vargas Monasterio",
                    Correo = "sc.leonardo.vargas.m@upds.net.bo",
                    DocumentoIdentidad = "8127564"
                };
                await EstudianteRepo.CrearOActualizarAsync(estDemo);
                todos.Add(estDemo);
            }

            var inputUser = input.Split('@')[0].Trim().ToLowerInvariant();

            var est = todos.FirstOrDefault(e =>
                (!string.IsNullOrEmpty(e.Codigo) && string.Equals(e.Codigo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Correo) && string.Equals(e.Correo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.DocumentoIdentidad) && string.Equals(e.DocumentoIdentidad.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Correo) && e.Correo.Split('@')[0].Trim().ToLowerInvariant() == inputUser) ||
                (!string.IsNullOrEmpty(e.Correo) && input.Contains('@') && 
                 string.Equals(dClean(e.Correo), dClean(input), StringComparison.OrdinalIgnoreCase))
            );

            // Búsqueda en otros tenants si no está en el default
            if (est == null)
            {
                var otrasInst = await InstitucionRepo.ListarTodasAsync();
                foreach (var i in otrasInst.Where(x => x.Id != _institucionId && x.Estado == "activo"))
                {
                    var estsI = await EstudianteRepo.ListarPorInstitucionAsync(i.Id);
                    est = estsI.FirstOrDefault(e =>
                        (!string.IsNullOrEmpty(e.Codigo) && string.Equals(e.Codigo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(e.Correo) && string.Equals(e.Correo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(e.DocumentoIdentidad) && string.Equals(e.DocumentoIdentidad.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(e.Correo) && e.Correo.Split('@')[0].Trim().ToLowerInvariant() == inputUser) ||
                        (!string.IsNullOrEmpty(e.Correo) && input.Contains('@') && 
                         string.Equals(dClean(e.Correo), dClean(input), StringComparison.OrdinalIgnoreCase))
                    );
                    if (est != null) break;
                }
            }

            if (est != null)
            {
                SessionService.IniciarSesionEstudiante(est);
                Snackbar.Add($"Bienvenido, {est.NombreCompleto}", Severity.Success);
                Navigation.NavigateTo("/estudiante/materias");
            }
            else
            {
                Snackbar.Add("No se encontró ningún estudiante con ese código o correo registrado.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al iniciar sesión: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task IngresarComoDocenteAsync()
    {
        var input = _docenteInput?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(input))
        {
            Snackbar.Add("Por favor ingresa tu correo institucional o código de docente.", Severity.Warning);
            return;
        }

        _cargando = true;
        try
        {
            // Validar estado del tenant
            var inst = await InstitucionRepo.ObtenerPorIdAsync(_institucionId);
            if (inst != null && inst.Estado != "activo")
            {
                Snackbar.Add($"El servicio para {inst.Nombre} se encuentra suspendido temporalmente por administración central.", Severity.Error);
                return;
            }

            var docentes = (await DocenteRepo.ListarPorInstitucionAsync(_institucionId)).ToList();
            if (docentes.Count == 0 && _institucionId == Guid.Parse("11111111-1111-1111-1111-111111111111"))
            {
                var docDemo = new SLAC.Core.Docentes.Entities.Docente
                {
                    InstitucionId = _institucionId,
                    UserId = Guid.Parse("55555555-5555-5555-5555-555555555555"),
                    Nombres = "Jimmy",
                    Apellidos = "Requena",
                    Correo = "sc.jimmy.requena.l@upds.edu.bo",
                    Codigo = "87438"
                };
                await DocenteRepo.GuardarAsync(docDemo);
                docentes.Add(docDemo);
            }

            var inputUser = input.Split('@')[0].Trim().ToLowerInvariant();

            var docente = docentes.FirstOrDefault(d =>
                (!string.IsNullOrEmpty(d.Correo) && string.Equals(d.Correo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Codigo) && string.Equals(d.Codigo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Correo) && d.Correo.Split('@')[0].Trim().ToLowerInvariant() == inputUser) ||
                (!string.IsNullOrEmpty(d.Correo) && input.Contains('@') && 
                 string.Equals(dClean(d.Correo), dClean(input), StringComparison.OrdinalIgnoreCase))
            );

            // Búsqueda en otros tenants si no está en el default
            if (docente == null)
            {
                var otrasInst = await InstitucionRepo.ListarTodasAsync();
                foreach (var i in otrasInst.Where(x => x.Id != _institucionId && x.Estado == "activo"))
                {
                    var docsI = await DocenteRepo.ListarPorInstitucionAsync(i.Id);
                    docente = docsI.FirstOrDefault(d =>
                        (!string.IsNullOrEmpty(d.Correo) && string.Equals(d.Correo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(d.Codigo) && string.Equals(d.Codigo.Trim(), input, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(d.Correo) && d.Correo.Split('@')[0].Trim().ToLowerInvariant() == inputUser) ||
                        (!string.IsNullOrEmpty(d.Correo) && input.Contains('@') && 
                         string.Equals(dClean(d.Correo), dClean(input), StringComparison.OrdinalIgnoreCase))
                    );
                    if (docente != null) break;
                }
            }

            if (docente == null)
            {
                Snackbar.Add("Docente no encontrado. Verifica tu correo o código registrado.", Severity.Error);
                return;
            }

            SessionService.IniciarSesionDocente(docente);
            Snackbar.Add($"Bienvenido docente, {docente.NombreCompleto}", Severity.Success);
            Navigation.NavigateTo("/docente/materias");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al ingresar docente: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string dClean(string val) =>
        val.Replace("@upds.edu.bo", "", StringComparison.OrdinalIgnoreCase)
           .Replace("@upds.net.bo", "", StringComparison.OrdinalIgnoreCase)
           .Trim();

    private async Task IngresarComoAdmin()
    {
        var correo = _correoAdminInput?.Trim() ?? string.Empty;
        var codigo = _codigoAdminInput?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(correo) || string.IsNullOrWhiteSpace(codigo))
        {
            Snackbar.Add("Ingresa el correo y código de administrador.", Severity.Warning);
            return;
        }

        // 1. Validar contra administradores institucionales registrados (Supabase y local)
        var adminInst = await AdminInstRepo.ValidarCredencialesAsync(correo, codigo);
        if (adminInst != null)
        {
            var instAsignada = await InstitucionRepo.ObtenerPorIdAsync(adminInst.InstitucionId);
            if (instAsignada != null && instAsignada.Estado != "activo")
            {
                Snackbar.Add($"La institución '{instAsignada.Nombre}' se encuentra suspendida o desactivada por la administración central.", Severity.Error);
                return;
            }

            SessionService.IniciarSesionAdmin(adminInst.InstitucionId, adminInst.NombreCompleto, adminInst.Correo);
            Snackbar.Add($"Sesión iniciada como Administrador de {instAsignada?.Nombre ?? "la institución"}.", Severity.Success);
            Navigation.NavigateTo("/admin/materias");
            return;
        }

        // 2. Credenciales oficiales fijas exclusivas de UPDS
        var esPinValido = codigo == "75604458" || codigo == "admin123" || codigo == "admin";
        var esUsuarioUpds = string.Equals(correo, "sc.upds.m@upds.net.bo", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(correo, "sc.upds.m@upds.edu.bo", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(correo, "sc.upds.m", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(correo, "admin", StringComparison.OrdinalIgnoreCase);

        if (esPinValido && esUsuarioUpds)
        {
            var inst = await InstitucionRepo.ObtenerPorIdAsync(_institucionId);
            if (inst != null && inst.Estado != "activo")
            {
                Snackbar.Add($"La institución '{inst.Nombre}' se encuentra suspendida temporalmente.", Severity.Error);
                return;
            }

            SessionService.IniciarSesionAdmin(_institucionId, "Administrador Institucional UPDS", correo);
            Snackbar.Add("Sesión iniciada como Administrador Institucional UPDS.", Severity.Success);
            Navigation.NavigateTo("/admin/materias");
        }
        else
        {
            Snackbar.Add("Credenciales de Administrador incorrectas. Revisa tus credenciales o solicita acceso al Administrador General.", Severity.Error);
        }
    }
}

